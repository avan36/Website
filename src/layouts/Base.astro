---
// The document shell every page shares: meta, fonts, tokens, and slots.
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative URL of the social preview image. */
  image?: string;
  /** Pin a theme (the island is always light); omit to follow the OS. */
  theme?: 'light' | 'dark';
  /** Extra class on <body>. */
  bodyClass?: string;
  /** Hide from search engines (e.g. 404). */
  noindex?: boolean;
  type?: 'website' | 'article';
}

const { title, description, image = '/media/og-default.png', theme, bodyClass, noindex = false, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ambrose Vannier" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fbf6ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12100d" media="(prefers-color-scheme: dark)" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ambrose Vannier" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/media/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/media/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Ambrose Vannier — Writing" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

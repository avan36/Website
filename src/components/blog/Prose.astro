---
// Typography for everything Markdown can produce. Styles are global under
// .prose because the rendered post body is not part of this component's scope.
---
<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    font-family: var(--font-read);
    font-optical-sizing: auto;
    /* ~18px on phones, settling at 21px on desktop */
    font-size: clamp(1.125rem, 1.02rem + 0.45vw, 1.3125rem);
    line-height: 1.6;
    font-weight: 400;
    color: var(--ink);
    font-kerning: normal;
    font-variant-ligatures: common-ligatures;
    font-variant-numeric: oldstyle-nums proportional-nums;
    hanging-punctuation: first allow-end last;
    overflow-wrap: break-word;
  }
  /* Light text on a dark ground reads heavier; take a little weight off. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .prose { font-weight: 370; }
  }
  :root[data-theme='dark'] .prose { font-weight: 370; }

  .prose > * { margin-block: 0; }
  .prose > * + * { margin-block-start: 1.1em; }

  .prose p,
  .prose li,
  .prose blockquote { text-wrap: pretty; }

  /* Headings: the display face, tight but not shouty */
  .prose h2,
  .prose h3,
  .prose h4 {
    font-family: var(--font-display);
    font-weight: 650;
    color: var(--ink);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .prose h2 {
    font-size: 1.4em;
    line-height: 1.15;
    margin-block-start: 2.1em;
  }
  .prose h3 {
    font-size: 1.12em;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-block-start: 1.9em;
  }
  .prose h4 {
    font-size: 0.82em;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-block-start: 1.9em;
  }
  .prose :is(h2, h3, h4) + * { margin-block-start: 0.6em; }

  .prose strong, .prose b { font-weight: 640; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .prose :is(strong, b) { font-weight: 600; }
  }
  :root[data-theme='dark'] .prose :is(strong, b) { font-weight: 600; }
  .prose em, .prose i { font-style: italic; }

  /* Links: quiet underline in the accent, solid on hover. No transition. */
  .prose a {
    color: var(--link);
    text-decoration-line: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--link) 45%, transparent);
    text-decoration-skip-ink: auto;
  }
  .prose a:hover { text-decoration-color: currentColor; }

  /* Lists: hang the markers in the margin so the text edge stays clean */
  .prose ul,
  .prose ol { padding-inline-start: 1.15em; }
  .prose li + li { margin-block-start: 0.55em; }
  .prose li > ul,
  .prose li > ol { margin-block-start: 0.55em; }
  .prose li::marker { color: var(--muted); }
  .prose ul > li::marker { content: '–\2002'; }
  .prose ol > li::marker {
    font-variant-numeric: lining-nums tabular-nums;
    font-size: 0.9em;
  }
  .prose li > p + p { margin-block-start: 0.6em; }
  /* A bold line introducing a list reads as a small label, so tighten the gap */
  .prose p:has(> strong:only-child) + :is(ul, ol) { margin-block-start: 0.6em; }

  /* With room to spare, top-level markers hang in the margin and list text
     keeps the paragraph edge. */
  @media (min-width: 880px) {
    .prose > ul,
    .prose > ol { padding-inline-start: 0; }
  }

  .prose blockquote {
    margin-inline: 0;
    padding-inline-start: 1.1em;
    border-inline-start: 2px solid var(--link);
    font-style: italic;
    color: var(--ink-2);
  }
  .prose blockquote > * + * { margin-block-start: 0.8em; }
  .prose blockquote p { margin: 0; }

  /* Code */
  .prose code,
  .prose kbd,
  .prose samp {
    font-family: var(--font-mono);
    font-size: 0.8em;
    font-variant-ligatures: none;
  }
  .prose :not(pre) > code {
    padding: 0.12em 0.36em;
    border-radius: 6px;
    background: var(--bg-sunken);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow-wrap: anywhere;
  }
  /* Code blocks stay calm and follow the page theme. Shiki's inline colors are
     overridden; if dual light/dark Shiki themes are ever configured, their
     --shiki-light / --shiki-dark variables are picked up automatically. */
  .prose pre {
    margin-inline: 0;
    padding: 1.1em 1.25em;
    border-radius: var(--r-sm);
    background: var(--bg-sunken) !important;
    color: var(--shiki-light, var(--ink)) !important;
    box-shadow: inset 0 0 0 1px var(--line);
    overflow-x: auto;
    line-height: 1.55;
    tab-size: 2;
    -webkit-overflow-scrolling: touch;
  }
  .prose pre code { font-size: 0.78em; padding: 0; background: none; box-shadow: none; }
  .prose pre span { color: var(--shiki-light, inherit) !important; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .prose pre { color: var(--shiki-dark, var(--ink)) !important; }
    :root:not([data-theme='light']) .prose pre span { color: var(--shiki-dark, inherit) !important; }
  }
  :root[data-theme='dark'] .prose pre { color: var(--shiki-dark, var(--ink)) !important; }
  :root[data-theme='dark'] .prose pre span { color: var(--shiki-dark, inherit) !important; }

  /* Media: full column width, softly rounded */
  .prose img,
  .prose video {
    width: 100%;
    height: auto;
    border-radius: var(--r-sm);
    background: var(--bg-sunken);
  }
  .prose p:has(> img:only-child) { margin-block: 1.8em; }
  .prose figure { margin-inline: 0; }
  .prose figcaption,
  .prose img + em {
    display: block;
    margin-block-start: 0.7em;
    font-size: 0.8em;
    line-height: 1.45;
    color: var(--muted);
  }

  /* A quiet section break */
  .prose hr {
    border: 0;
    margin-block: 2.4em;
    height: 1.6em;
    text-align: center;
    color: var(--muted);
    overflow: visible;
  }
  .prose hr::before {
    content: '\00B7\2003\00B7\2003\00B7';
    font-size: 1.1em;
    line-height: 1;
  }

  /* Tables, should a post ever need one */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .prose th,
  .prose td {
    padding: 0.5em 0.75em 0.5em 0;
    border-bottom: 1px solid var(--line);
    text-align: start;
    vertical-align: top;
  }
  .prose th { font-family: var(--font-ui); font-weight: 650; font-size: 0.85em; color: var(--ink-2); }

  .prose sup,
  .prose sub { line-height: 0; font-size: 0.7em; }
  .prose abbr[title] { text-decoration: underline dotted; }
  .prose mark { background: color-mix(in srgb, var(--sun) 35%, transparent); color: inherit; padding: 0 0.1em; }

  /* Footnotes (GFM) */
  .prose .footnotes { margin-block-start: 3em; font-size: 0.85em; color: var(--ink-2); }
  .prose .footnotes h2 { font-size: 0.9em; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .prose [data-footnote-ref] { text-decoration: none; }
</style>

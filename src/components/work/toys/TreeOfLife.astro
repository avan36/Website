---
// Map of Evolution: a tiny fan-shaped tree of life that grows branch by
// branch from the first cell out to today's tips.
import ToyFrame from '../ToyFrame.astro';
import Replay from '../Replay.astro';
---
<ToyFrame
  id="tree"
  label="Watch it grow"
  title="From the first cell to you"
  lede="Every living thing traces back to a single ancestor. Here's a pocket-sized sketch of the tree you can explore in full on the site."
  note="Heavily simplified: six tips instead of the whole tree, with approximate branching times."
>
  <div class="tol" data-tree>
    <div class="tol__canvas">
      <canvas role="img" aria-label="A tree of life growing from the first cell, about four billion years ago, out to Bacteria, Archaea, Plants, Fungi and Animals, including insects and you."></canvas>
    </div>
    <div class="tol__foot">
      <p class="tol__legend"><span class="tol__you" aria-hidden="true"></span>You are here</p>
      <Replay attr="data-tree-replay" label="Grow it again" />
    </div>
  </div>
</ToyFrame>

<style>
  .tol { display: grid; gap: var(--space-4); }
  .tol__canvas {
    height: clamp(270px, 36vw, 420px);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--bg-raised) 75%, transparent);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .tol__canvas canvas { width: 100%; height: 100%; }
  @media (max-width: 600px) { .tol__canvas { height: auto; aspect-ratio: 1.45; } }
  .tol__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  .tol__legend { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--step--1); color: var(--ink-2); font-weight: 600; }
  .tol__you { width: 12px; height: 12px; border-radius: 50%; background: var(--p); box-shadow: 0 0 0 4px color-mix(in oklab, var(--p) 25%, transparent); }
</style>

<script>
  import { cssVar, easeOutCubic, fitCanvas, onSchemeChange, reducedMotion, whenVisible } from '../lib';

  type Node = { label?: string; tip?: boolean; you?: boolean; r?: number; kids?: Node[] };

  // Radius is time: 0 = the first cell (~4 billion years ago), 1 = today.
  const TREE: Node = {
    label: 'First cell', r: 0,
    kids: [
      { label: 'Bacteria', tip: true },
      { r: 0.3, kids: [
        { label: 'Archaea', tip: true },
        { r: 0.5, kids: [
          { label: 'Plants', tip: true },
          { r: 0.66, kids: [
            { label: 'Fungi', tip: true },
            { label: 'Animals', r: 0.82, kids: [
              { label: 'Insects', tip: true },
              { label: 'You', tip: true, you: true },
            ] },
          ] },
        ] },
      ] },
    ],
  };

  type Placed = { n: Node; r: number; a: number; depth: number; parent?: Placed; t0: number; t1: number };

  function place(): Placed[] {
    const tips: Node[] = [];
    const walk = (n: Node) => (n.tip ? tips.push(n) : n.kids?.forEach(walk));
    walk(TREE);
    const A0 = Math.PI + 0.32, A1 = 2 * Math.PI - 0.32;
    const angle = new Map(tips.map((t, i) => [t, A0 + ((A1 - A0) * i) / (tips.length - 1)]));
    const out: Placed[] = [];
    const visit = (n: Node, depth: number, parent?: Placed): number => {
      const p: Placed = { n, r: n.tip ? 1 : n.r ?? 0, a: 0, depth, parent, t0: 0, t1: 0 };
      out.push(p);
      if (n.tip) p.a = angle.get(n)!;
      else {
        const as = n.kids!.map((k) => visit(k, depth + 1, p));
        p.a = as.reduce((s, x) => s + x, 0) / as.length;
      }
      return p.a;
    };
    visit(TREE, 0);
    // Timing: each branch starts growing when its parent's finishes.
    for (const p of out) {
      if (!p.parent) { p.t0 = 0; p.t1 = 0.25; continue; }
      p.t0 = p.parent.t1;
      p.t1 = p.t0 + 0.3 + (p.r - p.parent.r) * 0.9;
    }
    return out;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-tree]')) {
    const canvas = root.querySelector('canvas')!;
    const replay = root.querySelector<HTMLButtonElement>('[data-tree-replay]');
    const nodes = place();
    const END = Math.max(...nodes.map((p) => p.t1)) + 0.6;
    let raf = 0;
    let clock = 0; // seconds into the growth; END = fully grown
    let started = false;

    function draw(time: number) {
      const { ctx, w, h } = fitCanvas(canvas);
      const ink2 = cssVar(root, '--ink-2');
      const ink3 = cssVar(root, '--ink-3');
      const line = cssVar(root, '--line-strong');
      const accent = cssVar(root, '--p') || '#4caf6a';
      const small = w < 520;
      const cx = w / 2, cy = h - (small ? 36 : 44);
      const R = Math.min(w / 2 - (small ? 62 : 96), cy - (small ? 34 : 44));
      const pt = (r: number, a: number): [number, number] => [cx + Math.cos(a) * r * R, cy + Math.sin(a) * r * R];

      // Time rings and the baseline.
      ctx.lineWidth = 1;
      ctx.strokeStyle = line;
      ctx.setLineDash([3, 5]);
      for (const r of [1 / 3, 2 / 3, 1]) {
        ctx.beginPath();
        ctx.arc(cx, cy, r * R, Math.PI, 2 * Math.PI);
        ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.beginPath();
      ctx.moveTo(cx - R - 12, cy);
      ctx.lineTo(cx + R + 12, cy);
      ctx.stroke();

      ctx.font = `600 ${small ? 11 : 12}px ${getComputedStyle(root).fontFamily}`;
      ctx.fillStyle = ink3;
      ctx.textBaseline = 'top';
      ctx.textAlign = 'center';
      ctx.fillText('4 billion years ago', cx, cy + 10);
      ctx.textAlign = 'right';
      ctx.fillText('Today', cx + R + 12, cy + 10);

      // Branches.
      ctx.lineCap = 'round';
      ctx.strokeStyle = accent;
      for (const p of nodes) {
        if (!p.parent) continue;
        const t = Math.max(0, Math.min(1, (time - p.t0) / (p.t1 - p.t0)));
        if (t <= 0) continue;
        const q = p.parent;
        const rm = (q.r + p.r) / 2;
        const P0 = pt(q.r, q.a), P1 = pt(rm, q.a), P2 = pt(rm, p.a), P3 = pt(p.r, p.a);
        ctx.lineWidth = Math.max(1.8, 5.5 - p.depth * 0.75);
        ctx.beginPath();
        ctx.moveTo(P0[0], P0[1]);
        const steps = 28, upto = easeOutCubic(t);
        for (let i = 1; i <= steps; i++) {
          const s = (i / steps) * upto, u = 1 - s;
          const x = u * u * u * P0[0] + 3 * u * u * s * P1[0] + 3 * u * s * s * P2[0] + s * s * s * P3[0];
          const y = u * u * u * P0[1] + 3 * u * u * s * P1[1] + 3 * u * s * s * P2[1] + s * s * s * P3[1];
          ctx.lineTo(x, y);
        }
        ctx.stroke();
      }

      // Nodes and labels pop in as their branch arrives.
      for (const p of nodes) {
        const since = time - p.t1;
        if (since < 0) continue;
        const k = Math.min(1, since / 0.35);
        const pop = 1 + Math.sin(k * Math.PI) * 0.35;
        const [x, y] = pt(p.r, p.a);
        const base = p.n.you ? 7 : p.n.tip ? 5 : !p.parent ? 6 : 0;
        if (base) {
          if (p.n.you) {
            ctx.fillStyle = accent;
            ctx.globalAlpha = 0.22 * k;
            ctx.beginPath();
            ctx.arc(x, y, base * 2.2 * pop, 0, Math.PI * 2);
            ctx.fill();
            ctx.globalAlpha = 1;
          }
          ctx.fillStyle = accent;
          ctx.beginPath();
          ctx.arc(x, y, base * k * pop, 0, Math.PI * 2);
          ctx.fill();
        }
        if (!p.n.label || !p.parent) continue;
        ctx.globalAlpha = k;
        if (p.n.tip) {
          const lx = cx + Math.cos(p.a) * (R + 14), ly = cy + Math.sin(p.a) * (R + 14);
          const c = Math.cos(p.a);
          ctx.textAlign = c < -0.3 ? 'right' : c > 0.3 ? 'left' : 'center';
          ctx.textBaseline = Math.sin(p.a) < -0.85 ? 'bottom' : 'middle';
          ctx.fillStyle = p.n.you ? accent : ink2;
          ctx.font = `${p.n.you ? 750 : 650} ${small ? 13 : 15}px ${getComputedStyle(root).fontFamily}`;
          ctx.fillText(p.n.label, lx, ly);
        } else {
          ctx.textAlign = 'right';
          ctx.textBaseline = 'top';
          ctx.fillStyle = ink3;
          ctx.font = `italic 500 ${small ? 12 : 14}px ${cssVar(root, '--font-read') || 'Georgia'}`;
          ctx.fillText(p.n.label, x - 8, y + 7);
        }
        ctx.globalAlpha = 1;
      }
    }

    function play() {
      started = true;
      cancelAnimationFrame(raf);
      if (reducedMotion()) {
        clock = END;
        draw(clock);
        return;
      }
      const t0 = performance.now();
      const frame = (now: number) => {
        clock = Math.min(END, (now - t0) / 1000);
        draw(clock);
        if (clock < END) raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
    }

    draw(0);
    replay?.addEventListener('click', play);
    whenVisible(root, play, 0.4);
    const redraw = () => draw(started ? clock : 0);
    new ResizeObserver(redraw).observe(canvas);
    onSchemeChange(redraw);
    document.fonts?.ready.then(redraw);
  }
</script>

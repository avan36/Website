---
// Etymon mini-game: a word appears, the clock starts, and you guess where
// English got it (or, every third word, its oldest known ancestor). Each answer
// reveals the word's journey. Words and journeys are Etymon's own data; see
// etymologyRaceData.ts. Game rules live in etymologyRace.ts.
import ToyFrame from '../ToyFrame.astro';
import { RACE_LANGS, RACE_WORDS } from './etymologyRaceData';
import { ROUND_LENGTH } from './etymologyRace';
---
<ToyFrame
  id="er"
  label="Play · Mini-game"
  title="Etymology race"
  lede="Ten words, a ticking clock. Guess which language English borrowed each one from, or pick its oldest ancestor out of a line-up. Quick answers score more, and a streak multiplies everything."
  note="Words, journeys and stories from Etymon, which follows the OED, Etymonline and Wiktionary. The answer is the language English took the word from; the full journey shows where it started. Years are approximate."
>
  <div class="er" data-er data-words={JSON.stringify(RACE_WORDS)} data-langs={JSON.stringify(RACE_LANGS)}>
    <div class="er__hud">
      <p class="er__stat"><span class="er__k">Score</span> <span class="er__v" data-er-score>0</span></p>
      <p class="er__stat"><span class="er__k">Streak</span> <span class="er__v" data-er-streak>0</span><span class="er__mult" data-er-mult hidden></span></p>
      <p class="er__stat"><span class="er__k">Word</span> <span class="er__v"><span data-er-q>0</span>/{ROUND_LENGTH}</span></p>
      <label class="er__switch">
        <input type="checkbox" role="switch" data-er-clock checked />
        <span class="er__track" aria-hidden="true"></span>
        Clock
      </label>
    </div>

    <div class="er__card">
      <span class="er__glow" aria-hidden="true"></span>

      <!-- Start -->
      <div class="er__screen er__start" data-er-screen="start">
        <p class="er__kicker">{RACE_WORDS.length} words in the pot</p>
        <p class="er__big">Where did it <em>come from?</em></p>
        <ul class="er__rules">
          <li>Pick the language English borrowed the word from.</li>
          <li>Every third word, pick its oldest known ancestor instead.</li>
          <li>Answer with a tap, a click, or keys <kbd>1</kbd>–<kbd>4</kbd>. Turn the clock off for a relaxed game.</li>
        </ul>
        <button type="button" class="er__go" data-er-start>Start the race <span aria-hidden="true">→</span></button>
      </div>

      <!-- Question + reveal -->
      <div class="er__screen er__play" data-er-screen="play" hidden>
        <p class="er__kicker" data-er-prompt></p>
        <h3 class="er__word" data-er-word tabindex="-1"></h3>
        <p class="er__gloss" data-er-gloss></p>
        <div class="er__timer" data-er-timer>
          <span class="er__bar" data-er-bar></span>
          <span class="er__secs" data-er-secs aria-hidden="true"></span>
        </div>
        <ol class="er__options" data-er-options></ol>

        <div class="er__reveal" data-er-reveal hidden>
          <p class="er__verdict" data-er-verdict></p>
          <ol class="er__journey" data-er-journey aria-label="The word's journey, oldest first"></ol>
          <p class="er__story" data-er-story></p>
          <button type="button" class="er__go" data-er-next>Next word <span aria-hidden="true">→</span></button>
        </div>
      </div>

      <!-- End -->
      <div class="er__screen er__end" data-er-screen="end" hidden>
        <p class="er__kicker">Final score</p>
        <p class="er__final" data-er-final tabindex="-1">0</p>
        <p class="er__rank" data-er-rank></p>
        <p class="er__summary" data-er-summary></p>
        <button type="button" class="er__go" data-er-again>Race again <span aria-hidden="true">→</span></button>
      </div>
    </div>
    <p class="visually-hidden" aria-live="polite" data-er-live></p>
  </div>
</ToyFrame>

<style>
  .er { display: grid; gap: var(--space-4); }

  /* ---------- HUD ---------- */
  .er__hud {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--space-2) var(--space-5);
  }
  .er__stat { display: inline-flex; align-items: baseline; gap: var(--space-2); }
  .er__k {
    font-size: var(--step--1); font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .er__v { font-family: var(--font-mono); font-size: var(--step-1); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .er__mult {
    margin-left: 4px;
    padding: 1px 8px;
    border-radius: var(--r-pill);
    font-size: var(--step--1); font-weight: 700;
    color: #fff;
    background: var(--p);
  }
  .er__switch {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 44px;
    font-size: var(--step--1); font-weight: 650; color: var(--ink-2);
    cursor: pointer;
  }
  .er__switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .er__track {
    position: relative;
    width: 40px; height: 24px;
    border-radius: var(--r-pill);
    background: var(--line-strong);
    transition: background var(--dur-2);
  }
  .er__track::after {
    content: '';
    position: absolute; top: 3px; left: 3px;
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--bg-raised);
    box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease-spring);
  }
  .er__switch input:checked + .er__track { background: var(--p); }
  .er__switch input:checked + .er__track::after { transform: translateX(16px); }
  .er__switch input:focus-visible + .er__track { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ---------- Card ---------- */
  .er__card {
    position: relative;
    padding: clamp(20px, 4vw, 44px) clamp(16px, 3.6vw, 44px);
    border-radius: var(--r-lg);
    background: color-mix(in oklab, var(--bg-raised) 88%, var(--bg));
    box-shadow: var(--shadow-1), inset 0 0 0 1px var(--line);
    overflow: hidden;
    isolation: isolate;
    min-height: 420px;
  }
  .er__glow {
    position: absolute; z-index: -1;
    left: 50%; top: -10%;
    width: min(560px, 80%); height: 46%;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--p);
    opacity: 0.12;
    filter: blur(60px);
    pointer-events: none;
  }
  .er__screen { display: grid; justify-items: center; text-align: center; gap: var(--space-4); }
  .er__screen[hidden] { display: none; }
  .er__kicker {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .er__big {
    font-family: var(--font-read);
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.6rem);
    line-height: 1.05;
    color: var(--ink);
  }
  .er__big em { color: color-mix(in oklab, var(--p) 75%, var(--ink)); }
  .er__rules {
    display: grid; gap: var(--space-2);
    max-width: 34rem; margin: 0; padding: 0; list-style: none;
    color: var(--ink-2);
  }
  .er__rules li::before { content: '· '; color: var(--p); font-weight: 700; }
  kbd {
    font-family: var(--font-mono); font-size: 0.85em;
    padding: 0 5px; border-radius: 5px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .er__go {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 48px;
    padding: 10px 24px;
    border: 0; border-radius: var(--r-pill);
    background: var(--p);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 18px -8px color-mix(in oklab, var(--p) 80%, transparent);
    transition: transform var(--dur-2) var(--ease-spring), filter var(--dur-2);
  }
  @media (hover: hover) { .er__go:hover { filter: brightness(1.08); } }
  .er__go:active { transform: scale(0.96); }

  /* ---------- Question ---------- */
  .er__word {
    font-family: var(--font-read);
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5.2rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--ink);
    overflow-wrap: anywhere;
    outline: none;
  }
  .er__gloss { max-width: 36rem; font-family: var(--font-read); font-size: var(--step-0); color: var(--ink-2); }

  .er__timer {
    position: relative;
    width: min(100%, 420px);
    height: 8px;
    margin-block: var(--space-1) var(--space-2);
    border-radius: var(--r-pill);
    background: var(--line);
  }
  .er__timer[hidden] { display: none; }
  .er__bar {
    position: absolute; inset: 0;
    border-radius: inherit;
    background: var(--p);
    transform-origin: left center;
    transform: scaleX(var(--left, 1));
  }
  .er__timer.is-low .er__bar { background: var(--coral); }
  .er__secs {
    position: absolute; right: 0; top: 12px;
    font-family: var(--font-mono); font-size: 12px; color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .er__options {
    width: 100%;
    margin: var(--space-3) 0 0; padding: 0; list-style: none;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3);
  }
  @media (max-width: 520px) { .er__options { grid-template-columns: 1fr; } }
  .er__opt {
    position: relative;
    width: 100%; min-height: 56px;
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-3);
    padding: 10px 16px;
    border: 0; border-radius: var(--r-md);
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition: box-shadow var(--dur-2), background var(--dur-2), transform var(--dur-2) var(--ease-spring);
  }
  @media (hover: hover) { .er__opt:not(:disabled):hover { box-shadow: inset 0 0 0 2px var(--p); } }
  .er__opt:not(:disabled):active { transform: scale(0.98); }
  .er__opt:disabled { cursor: default; }
  .er__n {
    display: grid; place-items: center;
    width: 26px; height: 26px; border-radius: 8px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 700;
    color: var(--ink-3);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .er__label { display: grid; gap: 2px; font-weight: 650; overflow-wrap: anywhere; }
  .er__label.is-form { font-family: var(--font-read); font-size: 1.25rem; font-weight: 500; }
  .er__hint { font-family: var(--font-ui); font-size: var(--step--1); font-weight: 600; color: var(--ink-3); }
  .er__mark { font-weight: 800; font-size: 1.1rem; }
  .er__opt.is-right {
    background: color-mix(in oklab, var(--leaf) 16%, var(--bg-raised));
    box-shadow: inset 0 0 0 2px var(--leaf);
  }
  .er__opt.is-wrong {
    background: color-mix(in oklab, var(--coral) 14%, var(--bg-raised));
    box-shadow: inset 0 0 0 2px var(--coral);
  }
  .er__opt.is-dim { opacity: 0.55; }
  .er__opt.is-right .er__mark { color: color-mix(in oklab, var(--leaf) 60%, var(--ink)); }
  .er__opt.is-wrong .er__mark { color: color-mix(in oklab, var(--coral) 70%, var(--ink)); }

  /* ---------- Reveal ---------- */
  .er__reveal { width: 100%; display: grid; justify-items: center; gap: var(--space-4); margin-top: var(--space-3); }
  .er__reveal[hidden] { display: none; }
  .er__verdict { font-size: var(--step-1); font-weight: 700; color: var(--ink); }
  .er__verdict .pts { color: color-mix(in oklab, var(--p) 70%, var(--ink)); font-family: var(--font-mono); }
  .er__journey {
    width: 100%;
    margin: 0; padding: 0; list-style: none;
    display: flex; flex-wrap: wrap; justify-content: center; align-items: stretch;
    gap: var(--space-2);
  }
  .er__stage {
    position: relative;
    display: grid; gap: 2px; justify-items: center;
    min-width: 96px; max-width: 200px;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line);
    animation: er-in 520ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 110ms);
  }
  .er__stage + .er__stage::before {
    content: '→';
    position: absolute; left: -13px; top: 50%; translate: 0 -50%;
    font-size: 12px; color: var(--ink-3);
  }
  .er__stage:last-child { box-shadow: inset 0 0 0 1.5px var(--p); }
  .er__sf { font-family: var(--font-read); font-size: 1.15rem; color: var(--ink); overflow-wrap: anywhere; }
  .er__sn { font-family: var(--font-read); font-size: 0.95rem; color: var(--ink-2); }
  .er__sl { font-size: var(--step--1); font-weight: 650; color: var(--ink-2); }
  .er__sy { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; color: var(--ink-3); }
  .er__sm { font-family: var(--font-read); font-style: italic; font-size: 0.95rem; color: var(--ink-2); }
  .er__story { max-width: 60ch; font-family: var(--font-read); font-size: var(--step-0); line-height: 1.55; color: var(--ink-2); }

  @keyframes er-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .er__opt.is-wrong.is-shake { animation: er-shake 380ms var(--ease-out); }
  @keyframes er-shake {
    20%, 60% { transform: translateX(-5px); }
    40%, 80% { transform: translateX(5px); }
  }

  /* ---------- End ---------- */
  .er__final {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 2rem + 5vw, 5.5rem);
    font-weight: 600;
    line-height: 1;
    color: color-mix(in oklab, var(--p) 75%, var(--ink));
    outline: none;
  }
  .er__rank { font-family: var(--font-read); font-style: italic; font-size: var(--step-2); color: var(--ink); }
  .er__summary { color: var(--ink-2); max-width: 36rem; }

  @media (prefers-reduced-motion: reduce) {
    .er__stage, .er__opt.is-wrong.is-shake { animation: none; }
    .er__track, .er__track::after, .er__opt, .er__go { transition: none; }
  }
</style>

<script>
  import { makeRng, randomSeed } from './rng';
  import { TIME_LIMIT, answer, buildRound, formatYear, rank, readableForm, startState, type Question, type RaceState } from './etymologyRace';
  import type { RaceWord } from './etymologyRaceData';
  import { reducedMotion } from '../lib';

  const BEST_KEY = 'av-etymology-race-best';
  const readBest = () => {
    try { return Number(localStorage.getItem(BEST_KEY)) || 0; } catch { return 0; }
  };
  const writeBest = (n: number) => {
    try { localStorage.setItem(BEST_KEY, String(n)); } catch { /* private mode: no best score */ }
  };

  const el = <T extends HTMLElement = HTMLElement>(tag: string, cls?: string, text?: string): T => {
    const e = document.createElement(tag) as T;
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-er]')) {
    const words = JSON.parse(root.dataset.words || '[]') as RaceWord[];
    const langs = JSON.parse(root.dataset.langs || '{}') as Record<string, string>;
    const langName = (c: string) => langs[c] ?? c;
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const screens = [...root.querySelectorAll<HTMLElement>('[data-er-screen]')];
    const scoreEl = $('[data-er-score]'), streakEl = $('[data-er-streak]'), multEl = $('[data-er-mult]'), qEl = $('[data-er-q]');
    const clock = $<HTMLInputElement>('[data-er-clock]');
    const promptEl = $('[data-er-prompt]'), wordEl = $('[data-er-word]'), glossEl = $('[data-er-gloss]');
    const timerEl = $('[data-er-timer]'), barEl = $('[data-er-bar]'), secsEl = $('[data-er-secs]');
    const optionsEl = $('[data-er-options]');
    const revealEl = $('[data-er-reveal]'), verdictEl = $('[data-er-verdict]'), journeyEl = $('[data-er-journey]'), storyEl = $('[data-er-story]');
    const nextBtn = $<HTMLButtonElement>('[data-er-next]');
    const finalEl = $('[data-er-final]'), rankEl = $('[data-er-rank]'), summaryEl = $('[data-er-summary]');
    const live = $('[data-er-live]');

    let round: Question[] = [];
    let state: RaceState = startState();
    let q: Question | null = null;
    let answered = true;
    let timed = clock.checked;
    // Clock: remaining ms, ticking only while the question is open and the tab visible.
    let remaining = 0, lastTick = 0, raf = 0, warned = false, lastSecs = -1;

    const show = (name: string) => screens.forEach((s) => (s.hidden = s.dataset.erScreen !== name));
    const say = (t: string) => {
      live.textContent = '';
      requestAnimationFrame(() => (live.textContent = t));
    };

    function hud() {
      scoreEl.textContent = state.score.toLocaleString('en-US');
      streakEl.textContent = String(state.streak);
      const m = 1 + 0.25 * Math.min(state.streak, 4);
      multEl.hidden = m === 1;
      multEl.textContent = `×${m}`;
      qEl.textContent = String(Math.min(state.index + (answered ? 0 : 1), round.length || 10));
    }

    /* ---- clock ---- */
    function stopClock() {
      cancelAnimationFrame(raf);
      raf = 0;
    }
    function paint() {
      if (!q) return;
      const limit = TIME_LIMIT[q.kind] * 1000;
      const secs = Math.ceil(remaining / 1000);
      // Reduced motion: the bar steps once a second instead of gliding.
      const frac = reducedMotion() ? Math.ceil(remaining / 1000) * 1000 / limit : remaining / limit;
      barEl.style.setProperty('--left', Math.max(0, Math.min(1, frac)).toFixed(4));
      if (secs !== lastSecs) {
        lastSecs = secs;
        secsEl.textContent = `${secs}s`;
        timerEl.classList.toggle('is-low', secs <= 5);
      }
    }
    function tick(now: number) {
      remaining -= now - lastTick;
      lastTick = now;
      if (remaining <= 0) {
        remaining = 0;
        paint();
        return choose(null);
      }
      if (!warned && remaining <= 5000) {
        warned = true;
        say('5 seconds left.');
      }
      paint();
      raf = requestAnimationFrame(tick);
    }
    function runClock() {
      stopClock();
      if (!timed || answered || document.hidden) return;
      lastTick = performance.now();
      raf = requestAnimationFrame(tick);
    }
    document.addEventListener('visibilitychange', () => (document.hidden ? stopClock() : runClock()));

    clock.addEventListener('change', () => {
      timed = clock.checked;
      timerEl.hidden = !timed;
      if (timed && q && !answered) runClock();
      else stopClock();
    });

    /* ---- a question ---- */
    function ask() {
      q = round[state.index];
      answered = false;
      warned = false;
      lastSecs = -1;
      revealEl.hidden = true;
      const w = q.word;
      promptEl.textContent = q.kind === 'origin' ? 'Where did English get this word?' : 'Which is its oldest known ancestor?';
      wordEl.textContent = w.word;
      glossEl.textContent = w.gloss;
      optionsEl.replaceChildren(
        ...q.options.map((label, i) => {
          const li = el('li');
          const b = el<HTMLButtonElement>('button', 'er__opt');
          b.type = 'button';
          b.dataset.choice = String(i);
          const n = el('span', 'er__n', String(i + 1));
          n.setAttribute('aria-hidden', 'true');
          const text = el('span', `er__label${q!.kind === 'ancestor' ? ' is-form' : ''}`);
          text.append(el('span', '', label));
          if (q!.hints) text.append(el('span', 'er__hint', q!.hints[i]));
          const mark = el('span', 'er__mark');
          mark.setAttribute('aria-hidden', 'true');
          b.append(n, text, mark);
          li.append(b);
          return li;
        }),
      );
      remaining = TIME_LIMIT[q.kind] * 1000;
      timerEl.hidden = !timed;
      paint();
      hud();
      show('play');
      const total = round.length;
      say(`Word ${state.index + 1} of ${total}: ${w.word}. ${promptEl.textContent}${timed ? ` ${TIME_LIMIT[q.kind]} seconds.` : ''}`);
      optionsEl.querySelector<HTMLButtonElement>('button')?.focus({ preventScroll: true });
      runClock();
    }

    function choose(choice: number | null) {
      if (!q || answered) return;
      answered = true;
      stopClock();
      const secondsLeft = timed ? remaining / 1000 : null;
      const res = answer(state, q, choice, secondsLeft);
      state = res.state;

      const buttons = [...optionsEl.querySelectorAll<HTMLButtonElement>('.er__opt')];
      buttons.forEach((b, i) => {
        b.disabled = true;
        const mark = b.querySelector('.er__mark')!;
        if (i === q!.answer) {
          b.classList.add('is-right');
          mark.textContent = '✓';
        } else if (i === choice) {
          b.classList.add('is-wrong', 'is-shake');
          mark.textContent = '✗';
        } else b.classList.add('is-dim');
      });

      const right = q.options[q.answer];
      verdictEl.replaceChildren();
      if (res.right) {
        verdictEl.append(`${state.streak >= 3 ? `${state.streak} in a row! ` : 'Right! '}`, el('span', 'pts', `+${res.points}`));
      } else {
        verdictEl.textContent = choice == null ? `Time's up: it's ${right}.` : `Not quite: it's ${right}.`;
      }
      renderJourney(q.word);
      storyEl.textContent = q.word.story;
      revealEl.hidden = false;
      nextBtn.firstChild!.textContent = state.index >= round.length ? 'See your score ' : 'Next word ';
      hud();
      say(`${verdictEl.textContent} ${q.word.story}`);
      nextBtn.focus({ preventScroll: true });
      // Keep the reveal in view on small screens.
      if (revealEl.getBoundingClientRect().bottom > innerHeight) {
        revealEl.scrollIntoView({ block: 'nearest', behavior: reducedMotion() ? 'auto' : 'smooth' });
      }
    }

    function renderJourney(w: RaceWord) {
      journeyEl.replaceChildren(
        ...w.path.map((s, i) => {
          const li = el('li', 'er__stage');
          li.style.setProperty('--i', String(i));
          const f = readableForm(s.form);
          li.append(el('span', 'er__sf', f.text));
          if (f.native) li.append(el('span', 'er__sn', f.native));
          li.append(el('span', 'er__sl', langName(s.lang)), el('span', 'er__sy', formatYear(s.year)));
          if (s.meaning) li.append(el('span', 'er__sm', `‘${s.meaning}’`));
          return li;
        }),
      );
    }

    function finish() {
      q = null;
      const best = readBest();
      const isBest = state.score > best;
      if (isBest) writeBest(state.score);
      finalEl.textContent = state.score.toLocaleString('en-US');
      rankEl.textContent = rank(state.correct, round.length);
      summaryEl.textContent =
        `${state.correct} of ${round.length} right, best streak ${state.bestStreak}. ` +
        (isBest ? (best ? 'A new personal best!' : 'Your first score on the board.') : `Your best is ${best.toLocaleString('en-US')}.`);
      show('end');
      say(`Final score ${finalEl.textContent}. ${rankEl.textContent}. ${summaryEl.textContent}`);
      finalEl.focus({ preventScroll: true });
    }

    function start() {
      round = buildRound(words, makeRng(randomSeed()), undefined, langName);
      state = startState();
      ask();
    }

    $('[data-er-start]').addEventListener('click', start);
    $('[data-er-again]').addEventListener('click', start);
    nextBtn.addEventListener('click', () => (state.index >= round.length ? finish() : ask()));
    optionsEl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-choice]');
      if (b && !b.disabled) choose(Number(b.dataset.choice));
    });
    root.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || !q || answered) return;
      const n = Number(e.key);
      if (n >= 1 && n <= q.options.length) {
        e.preventDefault();
        choose(n - 1);
      }
    });
    hud();
  }
</script>

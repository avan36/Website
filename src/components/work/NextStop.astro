---
// The "next stop" ticket at the bottom of every project page. Clicking it
// plays the same circular color wipe the island uses, into the next project.
import type { Project } from '../../data/projects';
interface Props { next: Project; stop: number; total: number }
const { next, stop, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

// The stub's white type needs AA (4.5:1) against the stub, gloss included.
// Deepen the stop's color toward ink only as far as that takes: blue and
// purple barely move, orange becomes amber.
const GLOSS = 0.14;
const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
const lum = (c: number[]) => {
  const [r, g, b] = c.map((v) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const onWhite = (c: number[]) => 1.05 / (lum(mix(c, [255, 255, 255], GLOSS)) + 0.05);
let deep = rgb(next.hex);
for (let t = 0.02; onWhite(deep) < 4.6 && t <= 0.6; t += 0.02) deep = mix(rgb(next.hex), [29, 26, 22], t);
---
<section class="next" aria-labelledby="next-title">
  <div class="wrap">
    <div class="ticket-wrap">
      <a class="ticket" href={`/work/${next.slug}`} data-next data-slug={next.slug} data-color={next.hex} style={`--n:${next.color};--n-deep:rgb(${deep.join(' ')});--gloss:${GLOSS}`}>
        <span class="ticket__main">
          <span class="ticket__kicker" id="next-title">Next stop</span>
          <span class="ticket__name">{next.name}</span>
          <span class="ticket__blurb">{next.blurb}</span>
          <span class="ticket__place">
            <svg width="12" height="15" viewBox="0 0 14 18" aria-hidden="true"><path d="M7 0C3.1 0 0 3 0 6.9 0 12 7 18 7 18s7-6 7-11.1C14 3 10.9 0 7 0Zm0 9.6a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2Z" fill="currentColor" /></svg>
            {next.landmarkName}
          </span>
        </span>
        <span class="ticket__stub" aria-hidden="true">
          <span class="ticket__stop">Stop</span>
          <span class="ticket__num">{pad(stop)}<small>/{pad(total)}</small></span>
          <span class="ticket__go">
            <svg width="22" height="22" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </span>
      </a>
    </div>
    <p class="next__home"><a class="text-link" href="/">Or sail back to the island</a></p>
  </div>
</section>

<style>
  .next { margin-top: clamp(var(--space-8), 10vw, var(--space-10)); }
  .ticket-wrap {
    --stub: clamp(104px, 18vw, 190px);
    --notch: 13px;
    max-width: 820px;
    margin-inline: auto;
    filter: drop-shadow(0 2px 3px rgba(60, 40, 10, 0.08)) drop-shadow(0 18px 30px rgba(60, 40, 10, 0.12));
    transition: transform 600ms var(--ease-spring);
  }
  .ticket-wrap:has(.ticket:hover) { transform: rotate(-1.2deg) translateY(-4px); }
  .ticket-wrap:has(.ticket:active) { transform: rotate(-0.6deg) scale(0.99); }

  .ticket {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--stub);
    border-radius: 22px;
    text-decoration: none;
    color: var(--ink);
    background: var(--bg-raised);
    /* Two half-height masks, each punching a semicircle: the perforation notches. */
    -webkit-mask:
      radial-gradient(circle var(--notch) at calc(100% - var(--stub)) 0, #0000 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle var(--notch) at calc(100% - var(--stub)) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
    mask:
      radial-gradient(circle var(--notch) at calc(100% - var(--stub)) 0, #0000 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle var(--notch) at calc(100% - var(--stub)) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
  }
  .ticket:focus-visible { outline: none; }
  .ticket-wrap:has(.ticket:focus-visible) { outline: 3px solid var(--accent); outline-offset: 6px; border-radius: 24px; }

  .ticket__main {
    display: grid;
    gap: var(--space-2);
    padding: clamp(22px, 4vw, 40px) clamp(22px, 4vw, 44px);
  }
  .ticket__kicker {
    font-size: var(--step--1); font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3);
  }
  .ticket__name {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-top: var(--space-1);
  }
  .ticket__blurb { color: var(--ink-2); max-width: 36ch; }
  .ticket__place {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: var(--space-3);
    font-size: var(--step--1); font-weight: 650;
    color: color-mix(in oklab, var(--n) 62%, var(--ink));
  }
  .ticket__place svg { color: var(--n); }

  .ticket__stub {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-3);
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / var(--gloss)) 0, transparent 60%),
      var(--n-deep);
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }
  /* The perforation. */
  .ticket__stub::before {
    content: '';
    position: absolute;
    left: -1px; top: calc(var(--notch) + 6px); bottom: calc(var(--notch) + 6px);
    border-left: 2px dashed color-mix(in oklab, var(--n) 40%, var(--bg-raised));
  }
  .ticket__stop { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .ticket__num {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.2rem + 2.2vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .ticket__num small { font-size: 0.42em; letter-spacing: 0; margin-left: 2px; }
  .ticket__go {
    display: grid; place-items: center;
    width: 44px; height: 44px;
    margin-top: var(--space-3);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.24);
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.5);
    transition: transform var(--dur-3) var(--ease-spring), background var(--dur-2);
  }
  .ticket:hover .ticket__go { transform: translateX(5px); background: rgba(255, 255, 255, 0.36); }

  .next__home a { display: inline-block; padding-block: 12px; }
  .next__home { text-align: center; margin-top: var(--space-3); color: var(--ink-2); font-size: var(--step--1); }

  @media (max-width: 520px) {
    .ticket__go { width: 38px; height: 38px; }
    .ticket__blurb { font-size: var(--step--1); }
  }
</style>

<script>
  import { reducedMotion } from './lib';

  let veil: HTMLDivElement | null = null;
  let leaving = 0;

  // Back to how the page was: no veil, and no wipe waiting for a page we never reached.
  function takeDown() {
    clearTimeout(leaving);
    veil?.remove();
    veil = null;
    try {
      sessionStorage.removeItem('island:wipe');
    } catch {
      /* storage blocked: nothing was stored */
    }
  }

  document.querySelectorAll<HTMLAnchorElement>('a[data-next]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      // A wipe is already under way: let it finish rather than start another.
      if (veil) {
        e.preventDefault();
        return;
      }
      const color = a.dataset.color || '#000';
      try {
        sessionStorage.setItem('island:wipe', JSON.stringify({ slug: a.dataset.slug, color }));
      } catch {
        /* storage blocked: the next page simply loads without the reveal */
      }
      if (reducedMotion() || !document.body.animate) return;

      e.preventDefault();
      // Grow from the pointer, or from the arrow when activated by keyboard.
      let x = e.clientX, y = e.clientY;
      if (e.detail === 0) {
        const r = (a.querySelector('.ticket__go') ?? a).getBoundingClientRect();
        x = r.left + r.width / 2;
        y = r.top + r.height / 2;
      }
      const R = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) + 4;
      veil = document.createElement('div');
      veil.setAttribute('aria-hidden', 'true');
      Object.assign(veil.style, { position: 'fixed', inset: '0', zIndex: '2147483000', background: color, pointerEvents: 'none' });
      document.body.appendChild(veil);
      const anim = veil.animate(
        [{ clipPath: `circle(0px at ${x}px ${y}px)` }, { clipPath: `circle(${R}px at ${x}px ${y}px)` }],
        { duration: 620, easing: 'cubic-bezier(.65,0,.35,1)', fill: 'forwards' },
      );
      anim.onfinish = () => {
        window.location.href = a.href;
        // If that navigation is cancelled (a back swipe while the next page
        // loads, Escape, a dropped connection) nothing else fires, and the
        // veil would cover the page for good. pagehide clears this if we leave.
        leaving = window.setTimeout(takeDown, 2500);
      };
    });
  });

  // The page really is going: keep the veil up for the hand-off.
  window.addEventListener('pagehide', () => clearTimeout(leaving));
  // Coming back via the back button restores this page from the bfcache with
  // the veil still up. Take it down.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) takeDown();
  });
</script>

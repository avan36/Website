---
// Tiny flat drawings of the island landmarks, for projects without an app
// icon. Drawn in white on the accent disc; "cut" shapes take a deep tint.
import type { Project } from '../../data/projects';
interface Props { kind: Project['landmark'] }
const { kind } = Astro.props;
---
<svg class="landmark" viewBox="0 0 64 64" aria-hidden="true">
  {kind === 'cabin' && (
    <g>
      <path class="lm-smoke" d="M44 15 q-3 -3 0 -6 q3 -3 0 -6" />
      <rect class="lm-fill" x="41" y="13" width="6" height="12" rx="1" />
      <path class="lm-fill" d="M9 31 L32 12 L55 31 Z" />
      <rect class="lm-fill" x="14" y="29" width="36" height="24" rx="2" />
      <rect class="lm-cut" x="27.5" y="37" width="9" height="16" rx="1.5" />
      <rect class="lm-glow" x="18" y="34" width="7" height="7" rx="1" />
      <rect class="lm-glow" x="39" y="34" width="7" height="7" rx="1" />
    </g>
  )}
  {kind === 'tree' && (
    <g>
      <path class="lm-fill" d="M29 56 L30.5 36 L27 30 L30 31 L32 27 L34 31 L37 30 L33.5 36 L35 56 Z" />
      <circle class="lm-fill" cx="32" cy="22" r="13" />
      <circle class="lm-fill" cx="20" cy="29" r="9" />
      <circle class="lm-fill" cx="44" cy="29" r="9" />
      <circle class="lm-cut" cx="25" cy="20" r="2" />
      <circle class="lm-cut" cx="39" cy="24" r="2" />
      <circle class="lm-cut" cx="31" cy="30" r="2" />
      <rect class="lm-fill" x="16" y="55" width="32" height="3" rx="1.5" />
    </g>
  )}
  {kind === 'lighthouse' && (
    <g>
      <path class="lm-beam" d="M36 15 L60 9 L60 23 Z" />
      <path class="lm-beam" d="M28 15 L4 9 L4 23 Z" />
      <path class="lm-fill" d="M26 9 L32 4 L38 9 Z" />
      <rect class="lm-glow" x="27" y="10" width="10" height="9" rx="1.5" />
      <rect class="lm-fill" x="24" y="19" width="16" height="3" rx="1" />
      <path class="lm-fill" d="M26 22 H38 L41 56 H23 Z" />
      <path class="lm-cut" d="M25.6 30 H38.4 L38.9 36 H25.1 Z" />
      <path class="lm-cut" d="M24.7 42 H39.3 L39.8 48 H24.2 Z" />
      <rect class="lm-fill" x="16" y="55" width="32" height="3" rx="1.5" />
    </g>
  )}
  {kind === 'library' && (
    <g>
      <path class="lm-fill" d="M7 25 L32 10 L57 25 Z" />
      <path class="lm-cut" d="M17 22 L32 13.5 L47 22 Z" />
      <circle class="lm-glow" cx="32" cy="18.6" r="2.4" />
      <rect class="lm-fill" x="9" y="25" width="46" height="4" rx="1" />
      <rect class="lm-fill" x="12" y="30.5" width="40" height="21" />
      <path class="lm-glow" d="M16.5 47 V38.5 a3.5 3.5 0 0 1 7 0 V47 Z" />
      <path class="lm-glow" d="M40.5 47 V38.5 a3.5 3.5 0 0 1 7 0 V47 Z" />
      <path class="lm-cut" d="M27.5 51.5 V38 a4.5 4.5 0 0 1 9 0 V51.5 Z" />
      <rect class="lm-fill" x="9" y="51" width="46" height="3" rx="1" />
      <rect class="lm-fill" x="6" y="55" width="52" height="3" rx="1.5" />
    </g>
  )}
  {kind !== 'cabin' && kind !== 'tree' && kind !== 'lighthouse' && kind !== 'library' && (
    <g>
      <path class="lm-fill" d="M10 30 L32 13 L54 30 Z" />
      <rect class="lm-fill" x="15" y="29" width="34" height="24" rx="2" />
      <rect class="lm-cut" x="27.5" y="37" width="9" height="16" rx="1.5" />
    </g>
  )}
</svg>

<style>
  .landmark { width: 100%; height: 100%; overflow: visible; }
  .lm-fill { fill: #fff; }
  .lm-cut { fill: color-mix(in oklab, var(--p) 70%, #000); }
  .lm-glow { fill: #ffd98a; }
  .lm-beam { fill: #fff3c4; opacity: 0.55; }
  .lm-smoke { fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; opacity: 0.7; }
</style>

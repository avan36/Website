---
// The small "Replay" pill a few toys share. The toy's script finds it via
// the data attribute passed in.
interface Props { attr: string; label?: string }
const { attr, label = 'Replay' } = Astro.props;
---
<button type="button" class="replay" {...{ [attr]: '' }}>
  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
  {label}
</button>

<style>
  .replay {
    justify-self: start;
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: 9px 16px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-weight: 650;
    font-size: var(--step--1);
    color: var(--ink);
    cursor: pointer;
    transition: box-shadow var(--dur-2), transform var(--dur-2) var(--ease-spring);
  }
  .replay:hover { box-shadow: inset 0 0 0 1.5px var(--p); }
  .replay:active { transform: scale(0.96); }
  .replay svg { color: var(--p); transition: transform 600ms var(--ease-out); }
  .replay:hover svg { transform: rotate(-200deg); }
</style>

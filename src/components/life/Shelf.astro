---
// A little bookshelf of films and reality TV: what's on right now, and a few
// hot takes. Entries come from `shelf` in src/data/life.ts; drafts never show.
import { shelf } from '../../data/life';
import { publishedShelf } from './life';

const { watching, takes, empty } = publishedShelf(shelf);
const tones = ['var(--sea)', 'var(--sun)', 'var(--coral)', 'var(--leaf)', 'var(--c-quizmate)', 'var(--c-etymon)'];
const tone = (i: number) => tones[i % tones.length];
const kindLabel = { film: 'Film', tv: 'TV' } as const;
const rows = [
  { id: 'watching', title: 'Currently watching', items: watching },
  { id: 'takes', title: 'Hot takes', items: takes },
].filter((r) => r.items.length > 0);
---
<div class="shelf">
  <h3 class="shelf__title">The film &amp; reality-TV shelf</h3>

  {empty ? (
    <div class="shelf__row shelf__row--empty">
      <div class="shelf__books" aria-hidden="true">
        {[0, 1, 2, 3].map((i) => <span class="spine spine--blank" style={`--tone:${tone(i)};--h:${[78, 92, 70, 86][i]}%`}></span>)}
        <span class="spine spine--blank spine--lean" style={`--tone:${tone(4)};--h:80%`}></span>
      </div>
      <div class="shelf__plank" aria-hidden="true"></div>
      <p class="shelf__empty">Shelf being stocked. Check back soon.</p>
    </div>
  ) : (
    rows.map((row) => (
      <section class="shelf__row" aria-labelledby={`shelf-${row.id}`}>
        <h4 class="kicker shelf__label" id={`shelf-${row.id}`}>{row.title}</h4>
        <ul class="shelf__cards">
          {row.items.map((e, i) => (
            <li class="card" style={`--tone:${tone(i + (row.id === 'takes' ? 2 : 0))}`}>
              <p class="card__kind">{kindLabel[e.kind]}</p>
              <p class="card__title">{e.title}</p>
              {e.take && <p class="card__take">{e.take}</p>}
            </li>
          ))}
        </ul>
        <div class="shelf__plank" aria-hidden="true"></div>
      </section>
    ))
  )}
</div>

<style>
  .shelf { display: grid; gap: var(--space-5); }
  .shelf__title { font-size: var(--step-1); font-weight: 700; letter-spacing: -0.02em; }
  .shelf__row { display: grid; gap: var(--space-3); }
  .shelf__label { margin: 0; }

  /* The wooden plank everything stands on. */
  .shelf__plank {
    height: 12px;
    margin-top: -2px;
    border-radius: 3px;
    background: linear-gradient(180deg, #c99a68, #a5764a);
    box-shadow: 0 6px 10px -6px rgba(60, 40, 10, 0.5);
  }

  .shelf__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr));
    align-items: end;
    gap: var(--space-3);
  }
  .card {
    position: relative;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    min-height: 140px;
    padding: var(--space-5) var(--space-4) var(--space-4);
    border-radius: 6px 6px 2px 2px;
    background: var(--bg-raised);
    box-shadow: var(--shadow-1), inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  /* The spine's colored head band. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 8px;
    background: var(--tone);
  }
  .card:nth-child(3n + 2) { min-height: 156px; }
  .card__kind {
    justify-self: start;
    padding: 1px 8px;
    border-radius: var(--r-pill);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    background: color-mix(in oklab, var(--tone) 18%, var(--bg-raised));
  }
  .card__title { font-family: var(--font-display); font-weight: 700; font-size: var(--step-0); line-height: 1.2; color: var(--ink); }
  .card__take { font-family: var(--font-read); font-style: italic; line-height: 1.45; color: var(--ink-2); }

  /* Empty state: a few blank spines waiting for titles. */
  .shelf__books { display: flex; align-items: flex-end; gap: 6px; height: 96px; padding-inline: var(--space-4); }
  .spine {
    width: 22px;
    height: var(--h);
    border-radius: 3px 3px 1px 1px;
    background: color-mix(in oklab, var(--tone) 55%, var(--bg-raised));
    box-shadow: inset 0 8px 0 -4px color-mix(in oklab, var(--tone) 80%, var(--ink)), inset 0 0 0 1px var(--line);
  }
  .spine--lean { transform: rotate(14deg); transform-origin: bottom left; margin-left: 4px; }
  .shelf__empty { font-family: var(--font-read); font-style: italic; color: var(--ink-3); }
</style>

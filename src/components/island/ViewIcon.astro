---
// Icons for the four views of the world.
interface Props { id: 'island' | 'map' | 'text' | 'list' }
const { id } = Astro.props;
---
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {id === 'island' && (<><path d="M3 19c3-1.6 6-1.6 9 0s6 1.6 9 0" /><path d="M5 15.5c1.8-3 4-4.5 7-4.5s5.2 1.5 7 4.5" /><path d="M12 11V4.5M12 4.5c-1.8-1.4-4-1.3-5.5.2M12 4.5c1.8-1.4 4-1.3 5.5.2" /></>)}
  {id === 'map' && (<><path d="M9 4 3.5 6v14L9 18l6 2 5.5-2V4L15 6Z" /><path d="M9 4v14M15 6v14" /></>)}
  {id === 'text' && (<><rect x="3" y="4.5" width="18" height="15" rx="3" /><path d="m7 10 3 2.5L7 15M12.5 15H17" /></>)}
  {id === 'list' && (<><path d="M9 6h11M9 12h11M9 18h11" /><circle cx="4.5" cy="6" r="1" fill="currentColor" /><circle cx="4.5" cy="12" r="1" fill="currentColor" /><circle cx="4.5" cy="18" r="1" fill="currentColor" /></>)}
</svg>

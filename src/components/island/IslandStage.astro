---
// The full-viewport island: canvas host, loading state, HUD, label layer and
// the color wipes used when going into a place and coming back out.
import { person } from '../../data/projects';
---
<div id="isl-stage" class="isl-stage">
  <div class="isl-loader" role="status">
    <svg class="isl-loader__boat" width="96" height="64" viewBox="0 0 96 64" aria-hidden="true">
      <g class="isl-loader__bob">
        <path d="M47 8v30" stroke="#7d5134" stroke-width="2.5" stroke-linecap="round" />
        <path d="M49 10c9 6 15 15 17 25H49Z" fill="#fffaf2" />
        <path d="M45 15c-6 5-10 12-11 20h11Z" fill="#ff5a36" />
        <path d="M24 40h48l-6 9a4 4 0 0 1-3.4 2H33.4a4 4 0 0 1-3.4-2Z" fill="#2b8fb8" />
      </g>
      <path class="isl-loader__wave" d="M0 54c6 0 6-4 12-4s6 4 12 4 6-4 12-4 6 4 12 4 6-4 12-4 6 4 12 4 6-4 12-4 6 4 12 4 6-4 12-4 6 4 12 4" fill="none" stroke="#2b8fb8" stroke-width="3" stroke-linecap="round" />
    </svg>
    <p>Setting sail<span class="isl-loader__dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span></p>
  </div>

  <div id="isl-labels" class="isl-labels"></div>
  <div class="isl-vignette" aria-hidden="true"></div>

  <div class="isl-hud">
    <header class="isl-top">
      <a class="isl-brand" href="/" aria-label="Ambrose Vannier, home">
        <img src="/media/monogram.svg" width="40" height="40" alt="" />
        <span class="isl-brand__text">
          <span class="isl-brand__name">{person.name}</span>
          <span class="isl-brand__role">{person.role}</span>
        </span>
      </a>
      <nav class="isl-nav" aria-label="Primary">
        <button type="button" class="isl-chip" data-isl-list aria-pressed="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11" /><circle cx="4.5" cy="6" r="1" fill="currentColor" /><circle cx="4.5" cy="12" r="1" fill="currentColor" /><circle cx="4.5" cy="18" r="1" fill="currentColor" /></svg>
          <span class="isl-chip__label">List view</span>
        </button>
        <a class="isl-chip" href="/blog">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16Z" /><path d="M13.5 6.5l4 4" /></svg>
          <span class="isl-chip__label">Writing</span>
        </a>
        <a class="isl-chip" href="/contact">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
          <span class="isl-chip__label">Contact</span>
        </a>
        <button type="button" class="isl-chip isl-chip--icon isl-sound-top" data-isl-sound aria-pressed="false" aria-label="Sound">
          <svg class="isl-sound-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 5v14l-4.5-4.5H4Z" /><path d="m16 9.5 5 5M21 9.5l-5 5" /></svg>
          <svg class="isl-sound-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 5v14l-4.5-4.5H4Z" /><path d="M16 9a4.5 4.5 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11" /></svg>
        </button>
      </nav>
    </header>

    <section id="isl-card" class="isl-card" aria-labelledby="isl-card-title">
      <button type="button" class="isl-card__toggle" data-isl-card-toggle aria-expanded="true" aria-controls="isl-card-body">
        <span class="visually-hidden">Show or hide the introduction</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </button>
      <h1 id="isl-card-title" class="isl-card__title"><span class="isl-wave" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12M11 11.5v-7a1.5 1.5 0 0 1 3 0v7M14 11.5V6a1.5 1.5 0 0 1 3 0v8.5a6.5 6.5 0 0 1-6.5 6.5h-.5a6 6 0 0 1-4.6-2.2L3 15.6a1.6 1.6 0 0 1 2.4-2.1L8 16" /></svg>
      </span>Hi, I'm Ambrose.</h1>
      <div id="isl-card-body" class="isl-card__body">
        <p>I build apps people love to use and tools that keep the web honest. Explore the island: every place is something I've made.</p>
      </div>
    </section>

    <button type="button" class="isl-chip isl-chip--icon isl-sound-fab" data-isl-sound aria-pressed="false" aria-label="Sound">
      <svg class="isl-sound-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 5v14l-4.5-4.5H4Z" /><path d="m16 9.5 5 5M21 9.5l-5 5" /></svg>
      <svg class="isl-sound-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 5v14l-4.5-4.5H4Z" /><path d="M16 9a4.5 4.5 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11" /></svg>
    </button>

    <p class="isl-hint" aria-hidden="true">
      <span class="isl-hint__desk"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> or click to explore</span>
      <span class="isl-hint__touch">Tap anywhere to explore</span>
    </p>
  </div>

  <p id="isl-live" class="visually-hidden" aria-live="polite"></p>
</div>
<div id="isl-cover" class="isl-cover" aria-hidden="true"></div>
<div id="isl-wipe" class="isl-wipe" aria-hidden="true" hidden></div>

<style is:global>
  /* ---------- Modes ---------- */
  .isl-stage, .isl-cover { display: none; }
  html.isl-mode-play, html.isl-mode-play body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  html.isl-mode-play .isl-stage { display: block; }
  html.isl-mode-play .isl-list { display: none; }
  html.isl-mode-play.isl-returning .isl-cover { display: block; }

  .isl-stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: linear-gradient(to bottom, #8ccbeb 0%, #c4e6f2 45%, #ffd7b5 70%, #2fa6c9 70.2%, #2b8fb8 100%);
    color: var(--ink);
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }
  .isl-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
    touch-action: none;
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }
  html.isl-ready .isl-canvas { opacity: 1; }
  .isl-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(130% 95% at 50% 45%, transparent 62%, rgba(80, 40, 10, 0.16) 100%);
    z-index: 2;
  }

  /* ---------- Loader ---------- */
  .isl-loader {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 30;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 18px 26px 16px;
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-2);
    font-family: var(--font-display);
    font-weight: 650;
    color: var(--ink-2);
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out), visibility 0s 400ms;
  }
  html.isl-ready .isl-loader { opacity: 0; visibility: hidden; transform: translate(-50%, -40%) scale(0.96); }
  .isl-loader__bob { animation: isl-bob 1.6s ease-in-out infinite; transform-origin: 48px 46px; }
  .isl-loader__wave { animation: isl-wave 1.2s linear infinite; }
  .isl-loader__dots span { animation: isl-dot 1.2s infinite; opacity: 0.2; }
  .isl-loader__dots span:nth-child(2) { animation-delay: 0.2s; }
  .isl-loader__dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes isl-bob { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-4px) rotate(4deg); } }
  @keyframes isl-wave { to { transform: translateX(-24px); } }
  @keyframes isl-dot { 40% { opacity: 1; } }

  /* ---------- HUD ---------- */
  .isl-hud { position: absolute; inset: 0; pointer-events: none; z-index: 10; }
  .isl-hud > * { pointer-events: auto; }
  .isl-top {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    left: max(16px, env(safe-area-inset-left));
    right: max(16px, env(safe-area-inset-right));
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    pointer-events: none;
  }
  .isl-top > * { pointer-events: auto; }
  .isl-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 16px 6px 6px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    color: var(--ink);
  }
  .isl-brand img { border-radius: 12px; transition: transform var(--dur-3) var(--ease-spring); }
  .isl-brand:hover img { transform: rotate(-10deg) scale(1.08); }
  .isl-brand__text { display: grid; line-height: 1.1; }
  .isl-brand__name { font-family: var(--font-display); font-weight: 700; font-size: 17px; letter-spacing: -0.02em; }
  .isl-brand__role { font-size: 13px; color: var(--ink-3); font-weight: 550; }

  .isl-nav { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  .isl-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 16px 0 14px;
    border: 0;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow: var(--shadow-1);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--dur-2) var(--ease-spring), box-shadow var(--dur-2) var(--ease-out), background var(--dur-2);
  }
  .isl-chip:hover { transform: translateY(-2px); box-shadow: var(--shadow-2); background: #fff; }
  .isl-chip:active { transform: translateY(0) scale(0.96); }
  .isl-chip svg { color: var(--ink-2); flex: none; }
  .isl-chip--icon { width: 44px; padding: 0; justify-content: center; }
  .isl-chip[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .isl-chip[aria-pressed='true'] svg { color: var(--bg); }
  .isl-sound-on { display: none; }
  [data-isl-sound][aria-pressed='true'] .isl-sound-on { display: block; }
  [data-isl-sound][aria-pressed='true'] .isl-sound-off { display: none; }

  .isl-card {
    position: absolute;
    left: max(16px, env(safe-area-inset-left));
    bottom: max(16px, env(safe-area-inset-bottom));
    width: min(360px, calc(100vw - 32px));
    padding: 18px 52px 18px 20px;
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: var(--shadow-2);
    transition: width 420ms var(--ease-out), padding 420ms var(--ease-out);
  }
  .isl-card__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    letter-spacing: -0.03em;
    font-weight: 750;
    white-space: nowrap;
  }
  .isl-wave { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #fff1e6; color: var(--accent); flex: none; }
  .isl-wave svg { transform-origin: 70% 80%; animation: isl-hand 2.4s var(--ease-out) 2.2s 2; }
  @keyframes isl-hand { 0%, 60%, 100% { transform: rotate(0); } 10%, 30% { transform: rotate(16deg); } 20%, 40% { transform: rotate(-10deg); } }
  .isl-card__body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 420ms var(--ease-out), opacity 300ms, margin 420ms var(--ease-out);
    margin-top: 10px;
  }
  .isl-card__body p { overflow: hidden; color: var(--ink-2); font-size: 15.5px; line-height: 1.5; }
  .isl-card.is-collapsed { width: 276px; padding-top: 12px; padding-bottom: 12px; }
  .isl-card.is-collapsed .isl-card__body { grid-template-rows: 0fr; opacity: 0; margin-top: 0; }
  .isl-card__toggle {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: transform var(--dur-3) var(--ease-spring);
  }
  .isl-card__toggle::before {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: var(--bg-sunken);
    transition: background var(--dur-2);
  }
  .isl-card__toggle svg { position: relative; }
  .isl-card__toggle:hover::before { background: #ebe2d1; }
  .isl-card.is-collapsed .isl-card__toggle { transform: rotate(180deg); }

  .isl-hint {
    position: absolute;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom));
    transform: translate(-50%, 12px);
    padding: 10px 18px;
    border-radius: var(--r-pill);
    background: rgba(29, 26, 22, 0.82);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none !important;
    transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out);
  }
  .isl-hint kbd {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    height: 24px;
    margin-right: 3px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.25);
    font: 700 12px/1 var(--font-ui);
  }
  .isl-hint kbd:last-of-type { margin-right: 8px; }
  .isl-hint__touch { display: none; }
  html.isl-touch .isl-hint__touch { display: inline; }
  html.isl-touch .isl-hint__desk { display: none; }
  html.isl-hinting .isl-hint { opacity: 1; transform: translate(-50%, 0); animation: isl-hint-bob 2.4s ease-in-out 600ms infinite; }
  @keyframes isl-hint-bob { 50% { transform: translate(-50%, -4px); } }

  /* HUD entrance: arrives as the intro settles */
  .isl-top > *, .isl-card { opacity: 0; transform: translateY(-10px); transition: opacity 600ms var(--ease-out), transform 700ms var(--ease-spring); }
  .isl-card { transform: translateY(14px); }
  html.isl-ready .isl-top > * { opacity: 1; transform: none; transition-delay: 1.3s; }
  html.isl-ready .isl-card { opacity: 1; transform: none; transition-delay: 1.9s, 1.9s, 0s, 0s; }
  html.isl-ready.isl-played .isl-top > *, html.isl-ready.isl-played .isl-card { transition-delay: 0s; }

  /* ---------- Labels ---------- */
  .isl-labels { position: absolute; inset: 0; pointer-events: none; z-index: 5; overflow: hidden; }
  .isl-label { position: absolute; left: 0; top: 0; will-change: transform; }
  .isl-label__inner {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%);
    transform-origin: 50% 100%;
    transition: opacity 260ms var(--ease-out), transform 420ms var(--ease-spring), visibility 0s;
  }
  .isl-label.is-off .isl-label__inner {
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 10px) scale(0.85);
    transition: opacity 200ms var(--ease-out), transform 260ms var(--ease-out), visibility 0s 260ms;
  }
  .isl-label__inner::after {
    content: '';
    width: 2px;
    height: 16px;
    background: linear-gradient(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.2));
    border-radius: 2px;
  }
  .isl-label__pill {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 15px 8px 11px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 2px 4px rgba(60, 40, 10, 0.08), 0 8px 22px rgba(60, 40, 10, 0.14);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 680;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 360ms var(--ease-spring), box-shadow var(--dur-2);
  }
  .isl-label__pill:hover, .isl-label.is-hover .isl-label__pill, .isl-label.is-near .isl-label__pill { transform: translateY(-2px) scale(1.04); }
  .isl-label__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 22%, transparent);
  }
  .isl-label.is-near .isl-label__dot { animation: isl-pulse 1.6s ease-out infinite; }
  @keyframes isl-pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 55%, transparent); } 100% { box-shadow: 0 0 0 10px transparent; } }
  .isl-label__card {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    width: 252px;
    padding: 14px 16px 16px;
    border-radius: 20px;
    background: #fff;
    box-shadow: var(--shadow-3);
    text-align: left;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 10px) scale(0.92);
    transform-origin: 50% 100%;
    transition: opacity 200ms var(--ease-out), transform 300ms var(--ease-out);
  }
  .isl-label__card::before {
    content: '';
    position: absolute;
    left: 16px;
    right: 16px;
    top: 0;
    height: 4px;
    border-radius: 0 0 4px 4px;
    background: var(--c);
  }
  .isl-label.is-hover .isl-label__card, .isl-label.is-near .isl-label__card {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
    pointer-events: auto;
    transition: opacity 220ms var(--ease-out), transform 460ms var(--ease-spring);
  }
  .isl-label__kicker {
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-deep, var(--ink-3));
  }
  .isl-label__blurb { margin-top: 4px; font-size: 15.5px; line-height: 1.4; color: var(--ink-2); text-wrap: pretty; }
  .isl-label__enter {
    display: none;
    width: 100%;
    margin-top: 12px;
    padding: 11px 16px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--c-btn, var(--c));
    color: var(--c-on, #fff);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: transform var(--dur-2) var(--ease-spring), filter var(--dur-2);
  }
  .isl-label__enter:hover { transform: scale(1.03); filter: brightness(1.06); }
  .isl-label__enter:active { transform: scale(0.97); }
  .isl-label__enter kbd {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 22px;
    border-radius: 6px;
    background: color-mix(in srgb, currentColor 18%, transparent);
    font: 700 13px/1 var(--font-ui);
  }
  html.isl-touch .isl-label__enter kbd { display: none; }
  .isl-label.is-near .isl-label__enter { display: inline-flex; }
  .isl-label.is-going .isl-label__inner { transform: translate(-50%, -6px) scale(1.06); }

  /* ---------- Wipes ---------- */
  .isl-wipe, .isl-cover { position: fixed; inset: 0; z-index: 1000; pointer-events: none; }
  .isl-wipe[hidden] { display: none; }
  .isl-cover { z-index: 25; background: var(--isl-return, var(--accent)); }
  html.isl-mode-play.isl-returning .isl-loader { z-index: 40; }

  /* ---------- Small screens ---------- */
  .isl-sound-fab { display: none; }
  @media (max-width: 720px) {
    .isl-chip__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .isl-chip { width: 44px; padding: 0; justify-content: center; }
    .isl-nav { gap: 6px; flex-wrap: nowrap; }
    .isl-sound-top { display: none; }
    .isl-sound-fab {
      display: inline-flex;
      position: absolute;
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
      opacity: 0;
      transition: opacity 600ms var(--ease-out) 1.9s, transform var(--dur-2) var(--ease-spring);
    }
    html.isl-ready .isl-sound-fab { opacity: 1; }
    .isl-card { width: calc(100vw - 32px - 56px); }
    .isl-card.is-collapsed { width: 262px; }
    .isl-hint { bottom: auto; top: calc(max(16px, env(safe-area-inset-top)) + 64px); }
  }
  @media (max-width: 420px) {
    .isl-top { gap: 8px; }

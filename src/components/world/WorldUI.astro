---
// The overlays every renderer shares: toasts, the lost-word card, the catch
// card and the word hoard. Empty shells here; src/renderers/ui.ts fills them.
---
<div class="w-toasts" id="w-toasts" aria-live="polite"></div>
<dialog class="w-dialog" id="w-dialog" aria-labelledby="w-dialog-title"></dialog>

<style is:global>
  /* ---------- Toasts ---------- */
  .w-toasts {
    position: fixed;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 60;
    display: grid;
    justify-items: center;
    gap: 8px;
    width: min(420px, calc(100vw - 32px));
    transform: translateX(-50%);
    pointer-events: none;
  }
  .w-toast {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    padding: 10px 10px 10px 14px;
    border-radius: 18px;
    background: rgba(29, 26, 22, 0.92);
    color: #fff;
    box-shadow: var(--shadow-3);
    pointer-events: auto;
    animation: w-toast-in 520ms var(--ease-spring);
  }
  .w-toast.is-out { animation: w-toast-out 280ms var(--ease-out) forwards; }
  @keyframes w-toast-in { from { opacity: 0; transform: translateY(16px) scale(0.94); } }
  @keyframes w-toast-out { to { opacity: 0; transform: translateY(8px) scale(0.97); } }
  .w-toast__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--c, var(--accent)); flex: none; box-shadow: 0 0 0 4px color-mix(in srgb, var(--c, var(--accent)) 30%, transparent); }
  .w-toast__text { display: grid; line-height: 1.3; min-width: 0; }
  .w-toast__title { font-weight: 700; font-size: 15px; }
  .w-toast__body { font-size: 13.5px; color: rgba(255, 255, 255, 0.72); }
  .w-toast__action {
    flex: none;
    min-height: 40px;
    padding: 0 14px;
    border: 0;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }
  .w-toast__action:hover { background: rgba(255, 255, 255, 0.24); }
  html.isl-mode-play[data-view='island'] .w-toasts,
  html.isl-mode-play[data-view='map'] .w-toasts { bottom: calc(max(24px, env(safe-area-inset-bottom)) + 64px); }
  /* In the text view the bottom of the screen is the prompt. */
  html[data-view='text'] .w-toasts { bottom: calc(max(24px, env(safe-area-inset-bottom)) + 104px); }
  @media (max-width: 720px) {
    html.isl-mode-play .w-toasts { bottom: auto; top: calc(max(16px, env(safe-area-inset-top)) + 64px); }
  }

  /* ---------- Dialog ---------- */
  .w-dialog {
    width: min(460px, calc(100vw - 24px));
    max-height: min(86dvh, 760px);
    padding: 0;
    border: 0;
    border-radius: 28px;
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow: var(--shadow-3);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .w-dialog::backdrop { background: rgba(29, 26, 22, 0.4); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .w-dialog[open] { animation: w-pop 520ms var(--ease-spring); }
  .w-dialog[open]::backdrop { animation: w-fade 300ms var(--ease-out); }
  @keyframes w-pop { from { opacity: 0; transform: translateY(18px) scale(0.94); } }
  @keyframes w-fade { from { opacity: 0; } }
  .w-dialog--wide { width: min(640px, calc(100vw - 24px)); }

  .w-card { position: relative; padding: 28px 28px 24px; }
  .w-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: var(--c, var(--accent));
  }
  .w-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .w-close::before { content: ''; position: absolute; inset: 6px; border-radius: 50%; background: var(--bg-sunken); }
  .w-close svg { position: relative; }
  .w-kicker {
    font-size: 12.5px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--c, var(--accent)) 70%, var(--ink));
    padding-right: 44px;
  }
  .w-title { margin-top: 6px; font-size: var(--step-3); font-weight: 760; letter-spacing: -0.03em; }

  /* Lost word */
  .w-word__word { margin-top: 10px; font-family: var(--font-read); font-weight: 600; font-size: clamp(2.3rem, 9vw, 3.4rem); letter-spacing: -0.01em; line-height: 1; overflow-wrap: anywhere; }
  .w-word__word span { display: inline-block; animation: w-letter 700ms var(--ease-spring) both; animation-delay: calc(var(--i) * 45ms + 120ms); }
  @keyframes w-letter { from { opacity: 0; transform: translateY(0.4em) rotate(-8deg); filter: blur(4px); } }
  .w-word__gloss { margin-top: 10px; font-family: var(--font-read); font-style: italic; font-size: var(--step-1); line-height: 1.35; color: var(--ink-2); }
  .w-word__life { display: flex; align-items: center; gap: 10px; margin-top: 16px; font-size: 13.5px; font-weight: 600; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .w-word__bar { position: relative; flex: 1; height: 6px; border-radius: 3px; background: var(--bg-sunken); overflow: hidden; }
  .w-word__bar i { position: absolute; top: 0; bottom: 0; border-radius: 3px; background: var(--c, var(--accent)); opacity: 0.8; }
  .w-word__story { margin-top: 16px; font-family: var(--font-read); font-size: 17.5px; line-height: 1.55; text-wrap: pretty; }
  .w-word__more { margin-top: 18px; font-size: 14px; color: var(--ink-3); }
  .w-word__more a { color: inherit; font-weight: 650; }

  .w-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--line); }
  .w-progress { flex: 1; min-width: 120px; display: grid; gap: 6px; font-size: 13.5px; font-weight: 650; color: var(--ink-2); }
  .w-progress__track { display: flex; gap: 4px; }
  .w-progress__track i { flex: 1; height: 6px; border-radius: 3px; background: var(--bg-sunken); }
  .w-progress__track i.on { background: var(--ink); }
  .w-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--bg);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--dur-2) var(--ease-spring);
  }
  .w-btn:hover { transform: translateY(-1px); }
  .w-btn--ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line-strong); }
  .w-btn--c { background: color-mix(in srgb, var(--c) 86%, #000); color: #fff; }

  /* Catch */
  .w-catch__fish { display: block; margin: 8px 0 4px; color: var(--c); animation: w-flop 900ms var(--ease-spring) 200ms both; }
  @keyframes w-flop { 0% { transform: translateY(30px) rotate(40deg); opacity: 0; } 60% { transform: translateY(-6px) rotate(-12deg); opacity: 1; } 80% { transform: rotate(6deg); } }
  .w-catch__date { margin-top: 8px; font-size: 14px; font-weight: 600; color: var(--ink-3); }
  .w-catch__desc { margin-top: 10px; font-family: var(--font-read); font-size: 17.5px; line-height: 1.5; color: var(--ink-2); }
  .w-catch__tally { margin-top: 14px; font-size: 13.5px; color: var(--ink-3); }

  /* Hoard */
  .w-hoard__intro { margin-top: 8px; color: var(--ink-2); font-size: 15.5px; line-height: 1.5; max-width: 32rem; }
  .w-hoard__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 10px; margin-top: 18px; }
  .w-slot {
    position: relative;
    display: grid;
    align-content: start;
    gap: 4px;
    min-height: 96px;
    padding: 14px 16px 14px;
    border: 0;
    border-radius: 18px;
    background: var(--bg-sunken);
    color: var(--ink);
    text-align: left;
    font: inherit;
  }
  button.w-slot { cursor: pointer; transition: transform var(--dur-2) var(--ease-spring), box-shadow var(--dur-2); }
  button.w-slot:hover { transform: translateY(-2px); box-shadow: var(--shadow-2); }
  .w-slot.is-found { background: color-mix(in oklab, var(--c) 12%, var(--bg-raised)); box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--c) 30%, transparent); }
  .w-slot__word { font-family: var(--font-read); font-weight: 600; font-size: 22px; line-height: 1.1; }
  .w-slot__gloss { font-size: 13.5px; color: var(--ink-2); line-height: 1.35; }
  .w-slot__where { font-size: 11.5px; font-weight: 750; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-3); }
  .w-slot__blank { display: flex; gap: 4px; margin: 4px 0 2px; }
  .w-slot__blank i { width: 14px; height: 16px; border-bottom: 2.5px solid var(--line-strong); }
  .w-slot__hint { font-size: 13.5px; color: var(--ink-3); line-height: 1.35; font-style: italic; }
  .w-hoard__full {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 18px;
    background: linear-gradient(135deg, #1f2a44, #34305c);
    color: #fff;
  }
  .w-hoard__full p { flex: 1; font-size: 14.5px; line-height: 1.4; color: rgba(255, 255, 255, 0.85); }
  .w-hoard__full strong { display: block; color: #ffe9a8; font-size: 16px; }
  .w-switch { position: relative; width: 52px; height: 32px; flex: none; border: 0; border-radius: 16px; background: rgba(255, 255, 255, 0.24); cursor: pointer; }
  .w-switch::after { content: ''; position: absolute; top: 4px; left: 4px; width: 24px; height: 24px; border-radius: 50%; background: #fff; transition: transform var(--dur-2) var(--ease-spring); }
  .w-switch[aria-checked='true'] { background: #ffd56b; }
  .w-switch[aria-checked='true']::after { transform: translateX(20px); }
  /* Wardrobe */
  .w-ward__top { display: flex; align-items: center; gap: 18px; margin-top: 14px; }
  .w-ward__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 136px;
    height: 144px;
    border-radius: 24px;
    background: radial-gradient(circle at 50% 38%, color-mix(in oklab, var(--sky) 55%, var(--bg-raised)), var(--bg-sunken) 72%);
  }
  .w-ward__avatar svg { animation: w-ward-bob 3.2s ease-in-out infinite; }
  @keyframes w-ward-bob { 50% { transform: translateY(-3px); } }
  .w-ward__intro { display: grid; gap: 14px; min-width: 0; }
  .w-ward__intro .w-hoard__intro { margin-top: 0; }
  .w-ward__slot { margin-top: 20px; }
  .w-ward__slot-title { display: flex; align-items: baseline; gap: 10px; font-size: 12.5px; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .w-ward__slot-title span { font-size: 13px; font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--ink-3); }
  .w-ward__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: 10px; margin-top: 10px; }
  .w-ward__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 76px;
    padding: 12px 14px;
    border: 0;
    border-radius: 18px;
    background: var(--bg-sunken);
    color: var(--ink);
    text-align: left;
    font: inherit;
  }
  .w-ward__item.is-locked { align-items: flex-start; }
  .w-ward__icon { flex: none; }
  .w-ward__icon.is-locked * { fill: var(--line-strong) !important; stroke: var(--line-strong) !important; fill-opacity: 1 !important; }
  .w-ward__text { display: grid; gap: 3px; min-width: 0; }
  .w-ward__name { font-weight: 700; font-size: 15.5px; line-height: 1.2; }
  .w-ward__item.is-locked .w-ward__name { color: var(--ink-3); letter-spacing: 0.12em; }
  .w-ward__item .w-slot__hint { font-size: 12.5px; }
  button.w-ward__item { cursor: pointer; transition: transform var(--dur-2) var(--ease-spring), box-shadow var(--dur-2); }
  button.w-ward__item:hover { transform: translateY(-2px); box-shadow: var(--shadow-2); }
  .w-ward__item.is-unlocked { background: color-mix(in oklab, var(--c) 10%, var(--bg-raised)); box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--c) 26%, transparent); }
  .w-ward__item.is-on { background: color-mix(in oklab, var(--c) 20%, var(--bg-raised)); box-shadow: inset 0 0 0 2.5px var(--c); }
  .w-ward__item .w-ward__icon { transition: transform var(--dur-3) var(--ease-spring); }
  .w-ward__item.is-on .w-ward__icon { transform: rotate(-6deg) scale(1.08); }
  .w-ward__state {
    margin-left: auto;
    flex: none;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    font-size: 12.5px;
    font-weight: 750;
    background: var(--bg-raised);
    color: var(--ink-2);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }
  .w-ward__item.is-on .w-ward__state { background: var(--ink); color: var(--bg); box-shadow: none; }
  @media (max-width: 480px) {
    .w-ward__top { flex-direction: column; align-items: stretch; }
    .w-ward__avatar { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .w-ward__avatar svg { animation: none; }
  }

  .w-hoard__reset { margin-top: 16px; border: 0; background: none; padding: 8px 0; color: var(--ink-3); font: inherit; font-size: 13.5px; text-decoration: underline; cursor: pointer; }

  @media (max-width: 480px) {
    .w-card { padding: 24px 20px 20px; }
    .w-dialog { border-radius: 24px; }
  }
</style>

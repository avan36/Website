---
interface Props { href: string; app: string }
const { href, app } = Astro.props;
---
<a class="appstore" href={href} rel="noopener" aria-label={`Download ${app} on the App Store`}>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.572-2.27 1.206-2.98.804-.94 2.142-1.64 3.248-1.68.03.13.05.28.05.43zm4.565 15.71c-.03.07-.463 1.58-1.518 3.12-.945 1.34-1.94 2.71-3.43 2.71-1.517 0-1.9-.88-3.63-.88-1.698 0-2.302.91-3.67.91-1.377 0-2.332-1.26-3.428-2.8-1.287-1.82-2.323-4.63-2.323-7.28 0-4.28 2.797-6.55 5.552-6.55 1.448 0 2.675.95 3.6.95.865 0 2.222-1.01 3.902-1.01.642 0 2.95.06 4.461 2.22-.115.07-2.523 1.48-2.523 4.52 0 3.51 3.073 4.74 3.063 4.74z"/></svg>
  <span class="appstore__text"><span class="appstore__small">Download on the</span><span class="appstore__large">App Store</span></span>
</a>

<style>
  .appstore {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 20px 10px 16px;
    border-radius: var(--r-pill);
    background: #000; color: #fff;
    text-decoration: none;
    box-shadow: var(--shadow-1), inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    transition: transform var(--dur-2) var(--ease-spring), box-shadow var(--dur-2) var(--ease-out);
  }
  .appstore:hover { transform: translateY(-2px); box-shadow: var(--shadow-2), inset 0 0 0 1px rgba(255, 255, 255, 0.2); }
  .appstore__text { display: flex; flex-direction: column; line-height: 1.05; }
  .appstore__small { font-size: 11px; font-weight: 500; opacity: 0.9; }
  .appstore__large { font-size: 19px; font-weight: 600; letter-spacing: -0.02em; }
</style>

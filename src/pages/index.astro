---
// Home: the island. The page server-renders a complete list view (for no JS,
// no WebGL, reduced motion, search engines and "List view"), and the game
// mounts over it when the visitor can play.
import Base from '../layouts/Base.astro';
import IslandStage from '../components/island/IslandStage.astro';
import ListView from '../components/island/ListView.astro';
import { person, projects } from '../data/projects';

const colors: Record<string, string> = Object.fromEntries([
  ...projects.map((p) => [p.slug, p.hex]),
  ['blog', '#2b8fb8'],
  ['contact', '#ff5a36'],
]);
---
<Base
  title={`${person.name} · ${person.role}`}
  description="Ambrose Vannier builds apps people love to use and tools that keep the web honest. Explore his work as a tiny island, or browse the list."
  theme="light"
  bodyClass="isl-body"
>
  <script is:inline slot="head" define:vars={{ colors }}>
    // Decide island or list before first paint, so nothing jumps.
    (function () {
      var d = document.documentElement;
      var gl = !!(window.WebGL2RenderingContext || window.WebGLRenderingContext);
      var rm = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
      var pref = null, ret = null;
      try { pref = sessionStorage.getItem('island:view'); ret = sessionStorage.getItem('island:return'); } catch (e) {}
      var list = !gl || location.hash === '#work' || pref === 'list' || (rm && pref !== 'island');
      d.classList.add(list ? 'isl-mode-list' : 'isl-mode-play');
      if (gl) d.classList.add('isl-gl');
      if (!list && ret && colors[ret]) {
        d.classList.add('isl-returning');
        d.style.setProperty('--isl-return', colors[ret]);
      }
    })();
  </script>
  <main id="main">
    <IslandStage />
    <ListView />
  </main>
</Base>

<script>
  import '../game/boot';
</script>

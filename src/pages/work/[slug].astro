---
// One page per project. Visitors usually arrive here from the island, through
// a circular color wipe that EntranceReveal finishes.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EntranceReveal from '../../components/work/EntranceReveal.astro';
import ProjectHero from '../../components/work/ProjectHero.astro';
import ProjectActions from '../../components/work/ProjectActions.astro';
import Shots from '../../components/work/Shots.astro';
import NextStop from '../../components/work/NextStop.astro';
import TasteMatch from '../../components/work/toys/TasteMatch.astro';
import JournalChat from '../../components/work/toys/JournalChat.astro';
import CrawlField from '../../components/work/toys/CrawlField.astro';
import TreeOfLife from '../../components/work/toys/TreeOfLife.astro';
import PopQuiz from '../../components/work/toys/PopQuiz.astro';
import PackScan from '../../components/work/toys/PackScan.astro';
import WordJourney from '../../components/work/toys/WordJourney.astro';
import WritingDesk from '../../components/life/WritingDesk.astro';
import { projects, type Project } from '../../data/projects';
import { loadWorld } from '../../world/load';
import { GAME_INFO, isletAt, playableIn } from '../../renderers/games/catalog';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length], nextStop: ((i + 1) % projects.length) + 1 },
  }));
}

interface Props { project: Project; next: Project; nextStop: number }
const { project, next, nextStop } = Astro.props;

const toys: Record<string, (props: Record<string, never>) => unknown> = {
  'busy-beer': TasteMatch,
  'middle-place': JournalChat,
  'privacy-research': CrawlField,
  'map-of-evolution': TreeOfLife,
  etymon: WordJourney,
  quizmate: PopQuiz,
  eqoscan: PackScan,
};
const Toy = toys[project.slug];

// This project's game, if it has one out on an islet: the page sends you to play it there.
const world = await loadWorld();
const spot = world.activities.find((a) => a.kind === 'minigame' && a.game && a.place === project.slug && !playableIn(a.game, 'map'));
const game = spot?.game ? { name: GAME_INFO[spot.game].name, isle: isletAt(world, spot.at)?.name ?? null, at: spot.at } : null;

const title = `${project.name}: ${project.headline.replace(/[.!]$/, '')} · Ambrose Vannier`;
const clip = (s: string, n = 158) => (s.length <= n ? s : `${s.slice(0, s.lastIndexOf(' ', n - 1))}…`);
const description = clip(project.body.join(' '));

const textLinks = project.links.filter((l) => !l.kind || l.kind === 'text');
const isExternal = (href: string) => /^https?:/.test(href);
---
<Base title={title} description={description}>
  <EntranceReveal slug={project.slug} />
  <SiteHeader current="work" />

  <main id="main" class="project" style={`--p:${project.color}`}>
    <ProjectHero project={project} />

    {Toy && (
      <div class="wrap project__toy">
        <Toy />
      </div>
    )}

    {game && (
      <p class="wrap project__play">
        <a class="text-link" href="/?view=island" data-play-at={`${game.at.x},${game.at.z}`}>Play {game.name} on the island<span class="arrow" aria-hidden="true">→</span></a>
        {game.isle && <span class="project__where">It's out on {game.isle}, over the bridge.</span>}
      </p>
    )}

    <section class="about wrap" aria-labelledby="about-title">
      <div class="about__body">
        <h2 class="kicker about__label" id="about-title">About the project</h2>
        <div class="about__copy">
          {project.body.map((p) => <p>{p}</p>)}
        </div>

        {project.links.length > 0 && (
          <div class="about__links">
            <ProjectActions project={project} />
            {textLinks.length > 0 && (
              <ul class="about__text-links">
                {textLinks.map((l) => (
                  <li>
                    <a class="text-link" href={l.href} rel={isExternal(l.href) ? 'noopener' : undefined}>
                      {l.label}<span class="arrow" aria-hidden="true">{isExternal(l.href) ? '↗' : '→'}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}
      </div>

      <aside class="facts" aria-label="Project facts">
        <dl>
          <div>
            <dt>Platform</dt>
            <dd>{project.platforms}</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>
              <ul class="chips">
                {project.tags.map((t) => <li>{t}</li>)}
              </ul>
            </dd>
          </div>
          <div>
            <dt>On the island</dt>
            <dd>{project.landmarkName}</dd>
          </div>
        </dl>
      </aside>
    </section>

    <Shots project={project} />

    {project.slug === 'middle-place' && <WritingDesk />}

    {project.credits && (
      <section class="credits wrap" aria-label="Credits">
        <ul class="credits__logos">
          {project.credits.map((c) => (
            <li><img src={c.src} alt={c.alt} width={c.width} height={c.height} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
        {project.creditLine && <p class="credits__line">{project.creditLine}</p>}
      </section>
    )}

    <NextStop next={next} stop={nextStop} total={projects.length} />
  </main>

  <SiteFooter />
</Base>

<style>
  /* Toys can fling things past the screen edge (the quiz's confetti): never let
     that make the page scroll sideways. clip, not hidden, so .facts stays sticky. */
  .project { overflow-x: clip; }
  .project__toy { margin-top: var(--space-2); }
  .project__play {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-3);
    margin-top: clamp(var(--space-5), 4vw, var(--space-7));
    font-weight: 650;
  }
  .project__play .text-link { display: inline-block; padding-block: 12px; margin-block: -12px; }
  .project__where { font-weight: 500; font-size: var(--step--1); color: var(--ink-3); }

  /* ---------- About ---------- */
  .about {
    display: grid;
    gap: var(--space-7);
    margin-top: clamp(var(--space-8), 9vw, var(--space-10));
  }
  .about__body { max-width: var(--max-read); }
  .about__label { margin-bottom: var(--space-5); }
  .about__copy {
    display: grid;
    gap: 1.05em;
    font-family: var(--font-read);
    font-size: clamp(1.2rem, 1.08rem + 0.5vw, 1.45rem);
    line-height: 1.6;
    color: var(--ink);
    font-optical-sizing: auto;
  }
  .about__copy p:first-child {
    font-size: 1.12em;
    line-height: 1.5;
  }
  .about__links { display: grid; gap: var(--space-5); margin-top: var(--space-7); }
  .about__text-links {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6);
  }
  .about__text-links .text-link { white-space: nowrap; display: inline-block; padding-block: 12px; margin-block: -12px; }
  .arrow { display: inline-block; margin-left: 0.3em; transition: transform var(--dur-2) var(--ease-spring); text-decoration: none; }
  .text-link:hover .arrow { transform: translate(2px, -1px); }

  .facts dl {
    margin: 0;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border-radius: var(--r-lg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .facts dt {
    font-size: var(--step--1); font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--space-2);
  }
  .facts dd { margin: 0; font-weight: 600; color: var(--ink); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chips li {
    padding: 4px 12px;
    border-radius: var(--r-pill);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
    background: color-mix(in oklab, var(--p) 10%, var(--bg-raised));
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--p) 22%, transparent);
  }

  @media (min-width: 960px) {
    .about {
      grid-template-columns: minmax(0, 1fr) 300px;
      align-items: start;
      gap: var(--space-9);
    }
    .facts { position: sticky; top: var(--space-6); margin-top: calc(var(--space-5) + 1.2em); }
  }

  /* ---------- Credits ---------- */
  .credits {
    margin-top: clamp(var(--space-8), 8vw, var(--space-9));
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }
  .credits__logos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-4); }
  .credits__logos li {
    display: grid; place-items: center;
    width: 84px; height: 84px;
    padding: 12px;
    border-radius: var(--r-md);
    background: #fff;
    box-shadow: var(--shadow-1), inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .credits__logos img { width: 100%; height: 100%; object-fit: contain; }
  .credits__line { font-size: var(--step--1); color: var(--ink-3); }
</style>

<script>
  // Land in front of the game: the island starts you wherever the visit says you were standing.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-play-at]')) {
    a.addEventListener('click', () => {
      const [x, z] = a.dataset.playAt!.split(',').map(Number);
      try {
        sessionStorage.setItem('world:presence:v1', JSON.stringify({ at: null, pos: { x, z: z + 1.5 }, inside: null }));
        sessionStorage.removeItem('island:return');
        sessionStorage.removeItem('island:wipe');
      } catch {
        /* storage blocked: you start at the plaza instead */
      }
    });
  }
</script>

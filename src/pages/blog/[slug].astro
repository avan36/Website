---
import { render } from 'astro:content';
import Reading from '../../layouts/Reading.astro';
import Prose from '../../components/blog/Prose.astro';
import {
  getPosts, isoDate, formatLong, readingMinutes, postUrl, type Post,
} from '../../components/blog/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Newest first, so the next index is older and the previous one is newer.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, older: posts[i + 1], newer: posts[i - 1] },
  }));
}

interface Props { post: Post; older?: Post; newer?: Post }
const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const { title, description, date } = post.data;
const minutes = readingMinutes(post.body);
const url = new URL(postUrl(post), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: isoDate(date),
  dateModified: isoDate(date),
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: new URL('/media/og-default.png', Astro.site).href,
  inLanguage: 'en',
  timeRequired: `PT${minutes}M`,
  author: { '@type': 'Person', name: 'Ambrose Vannier', url: Astro.site?.href },
  publisher: { '@type': 'Person', name: 'Ambrose Vannier', url: Astro.site?.href },
};
// Keep "</script>" (or any "<") inside a string from closing the tag early.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<Reading title={`${title} — Ambrose Vannier`} description={description} type="article">
  <script slot="head" type="application/ld+json" set:html={jsonLdText} />
  <meta slot="head" property="article:published_time" content={isoDate(date)} />
  <meta slot="head" property="article:author" content="Ambrose Vannier" />

  <article class="post">
    <header class="post-head">
      <a class="post-back" href="/blog"><span aria-hidden="true">←</span> Writing</a>
      <p class="post-meta">
        <time datetime={isoDate(date)}>{formatLong(date)}</time>
        <span class="post-meta__sep" aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-standfirst">{description}</p>}
    </header>

    <Prose>
      <Content />
    </Prose>

    <footer class="post-end">
      <p class="post-signoff">
        Thanks for reading. If this sparked a thought, I’d love to hear it:{' '}
        <a href="/contact">say hello</a>.
      </p>

      {(older || newer) && (
        <nav class="post-pager" aria-label="More writing">
          {older ? (
            <a class="post-pager__link post-pager__link--older" href={postUrl(older)} rel="prev">
              <span class="post-pager__label"><span aria-hidden="true">←</span> Older</span>
              <span class="post-pager__title">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer ? (
            <a class="post-pager__link post-pager__link--newer" href={postUrl(newer)} rel="next">
              <span class="post-pager__label">Newer <span aria-hidden="true">→</span></span>
              <span class="post-pager__title">{newer.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}
    </footer>
  </article>
</Reading>

<style>
  .post-head {
    margin-block-end: clamp(var(--space-7), 6vw, var(--space-8));
  }

  .post-back {
    display: inline-block;
    margin-block-end: clamp(var(--space-6), 4vw, var(--space-7));
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }
  .post-back:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 0.25em; }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6em;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 500;
    font-variant-numeric: tabular-nums lining-nums;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
  .post-meta__sep { color: var(--ink-3); }

  .post-title {
    margin-block-start: var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 1.45rem + 2.6vw, 3.4rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.032em;
    color: var(--ink);
    text-wrap: balance;
  }

  .post-standfirst {
    margin-block-start: var(--space-5);
    font-family: var(--font-read);
    font-optical-sizing: auto;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.55rem);
    line-height: 1.42;
    font-weight: 400;
    color: var(--ink-2);
    text-wrap: pretty;
    hanging-punctuation: first allow-end last;
  }

  .post-end {
    margin-block-start: clamp(var(--space-8), 8vw, var(--space-9));
  }

  .post-signoff {
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--rule);
    font-family: var(--font-read);
    font-optical-sizing: auto;
    font-style: italic;
    font-size: clamp(1.06rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .post-signoff a {
    color: var(--link);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--link) 45%, transparent);
  }
  .post-signoff a:hover { text-decoration-color: currentColor; }

  .post-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
  }
  .post-pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--ink);
  }
  .post-pager__link--newer { text-align: end; grid-column: 2; }
  .post-pager__label {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
  }
  .post-pager__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.18em;
    text-decoration-color: transparent;
  }
  .post-pager__link:hover .post-pager__title { text-decoration-color: var(--link); }
  .post-pager__link:hover .post-pager__label { color: var(--ink-2); }

  @media (max-width: 560px) {
    .post-pager { grid-template-columns: 1fr; gap: var(--space-6); }
    .post-pager > span:empty { display: none; }
    .post-pager__link--newer { grid-column: auto; text-align: start; }
  }
</style>

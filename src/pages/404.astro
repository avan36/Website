---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

// One wave period, used as a repeating mask so the color can follow the theme.
const wave = `url("data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" width="160" height="40" viewBox="0 0 160 40"><path d="M0 20 Q20 6 40 20 T80 20 T120 20 T160 20 V40 H0 Z" fill="#000"/></svg>',
)}")`;
---
<Base title="Off the map · Ambrose Vannier" description="This page isn't on the island." noindex>
  <SiteHeader />

  <main id="main" class="lost" style={`--wave:${wave}`}>
    <div class="lost__scene" aria-hidden="true">
      <div class="lost__sun"></div>
      <svg class="boat" viewBox="0 0 120 110" width="150" height="138">
        <g class="boat__bob">
          <path d="M60 10 V74" stroke="#7a5230" stroke-width="3.5" stroke-linecap="round" />
          <path d="M62 14 L98 66 H62 Z" fill="#fffaf0" stroke="#e7dcc8" stroke-width="1.5" stroke-linejoin="round" />
          <path d="M58 22 L30 66 H58 Z" fill="#ffe2b8" stroke="#eecf9e" stroke-width="1.5" stroke-linejoin="round" />
          <path d="M60 10 L78 15 L60 20 Z" fill="#ff6b5b" />
          <text x="66" y="54" font-family="Bricolage Grotesque Variable, system-ui" font-weight="800" font-size="20" fill="#ff5a36">?</text>
          <path d="M18 74 H102 L92 92 Q90 96 85 96 H35 Q30 96 28 92 Z" fill="#ff5a36" />
          <path d="M22 81 H98" stroke="#ffb199" stroke-width="3" stroke-linecap="round" />
        </g>
      </svg>
      <div class="lost__sea">
        <span class="wave wave--1"></span>
        <span class="wave wave--2"></span>
        <span class="wave wave--3"></span>
      </div>
    </div>

    <div class="lost__copy wrap-read">
      <p class="kicker">404 · Lost at sea</p>
      <h1>You've drifted off the map.</h1>
      <p class="lost__lede">This page isn't on the island. Let's get you back to dry land.</p>
      <div class="lost__actions">
        <a class="btn" href="/"><span aria-hidden="true">←</span> Back to the island</a>
        <a class="text-link" href="/contact">Or send a message in a bottle</a>
      </div>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  .lost { padding-top: var(--space-6); text-align: center; }
  .lost__scene {
    position: relative;
    width: min(100% - 2 * var(--gutter), 560px);
    height: 240px;
    margin: 0 auto;
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    mask: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }
  .lost__sun {
    position: absolute;
    top: 26px; left: 50%;
    width: 120px; aspect-ratio: 1;
    margin-left: 40px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffd58f, var(--sun));
    opacity: 0.85;
  }
  .boat {
    position: absolute;
    left: 50%; bottom: 60px;
    translate: -50% 0;
  }
  .boat__bob { transform-box: view-box; transform-origin: 60px 96px; animation: bob 3.2s ease-in-out infinite; }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(7px) rotate(5deg); }
  }
  .lost__sea { position: absolute; inset: auto 0 0; height: 96px; }
  .wave {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    -webkit-mask: var(--wave) repeat-x 0 0 / 160px 40px, linear-gradient(#000, #000) no-repeat 0 40px / 100% 100%;
    mask: var(--wave) repeat-x 0 0 / 160px 40px, linear-gradient(#000, #000) no-repeat 0 40px / 100% 100%;
    animation: drift 7s linear infinite;
  }
  .wave--1 { height: 96px; background: color-mix(in oklab, var(--sky) 70%, var(--bg)); animation-duration: 9s; animation-direction: reverse; }
  .wave--2 { height: 72px; background: var(--sea); opacity: 0.9; }
  .wave--3 { height: 46px; background: var(--sea-deep); animation-duration: 5s; }
  @keyframes drift {
    to { -webkit-mask-position: 160px 0, 0 40px; mask-position: 160px 0, 0 40px; }
  }

  .lost__copy { display: grid; justify-items: center; gap: var(--space-4); margin-top: var(--space-7); }
  .lost__copy h1 { font-size: clamp(2.4rem, 1.5rem + 4vw, 4.5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
  .lost__lede { font-family: var(--font-read); font-size: var(--step-1); color: var(--ink-2); max-width: 30ch; }
  .lost__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-4); }
</style>

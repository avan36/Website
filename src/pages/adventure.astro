---
// The adventure: a mode of its own, away from the island. Each chapter is a
// place from my life you can drive round. The page lists the finished
// chapters with a map of each (which also works without JavaScript or 3D);
// pressing Drive loads the 3D chapter over the page (src/adventure/play.ts).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CampusMap from '../components/adventure/CampusMap.astro';
import { playableChapters } from '../adventure/levels';
import { landmarks } from '../adventure/wesleyan';

const list = playableChapters();
const first = list[0];
---
<Base
  title="Adventure · Ambrose Vannier"
  description="Chapters from Ambrose Vannier's life, one drive at a time. Race a lap of Wesleyan's campus, past Usdan, Olin and Exley."
  theme="light"
>
  <SiteHeader />
  <main id="main" class="wrap adv">
    <header class="adv-head">
      <h1>Adventure</h1>
      <p class="adv-lede">Chapters from my life, one drive at a time. Pick one and take the wheel.</p>
    </header>

    <ol class="adv-chapters">
      {list.map((c) => (
        <li class="adv-chapter" style={`--c: ${c.color}`}>
          <div class="adv-chapter__map">
            {c.id === 'wesleyan' && <CampusMap color={c.color} />}
          </div>
          <div class="adv-chapter__text">
            <p class="adv-chapter__n">Chapter {c.n}</p>
            <h2>{c.title}</h2>
            <p class="adv-chapter__where">{c.where}</p>
            <p>{c.blurb}</p>
            <p>{c.play}</p>
            <p class="adv-chapter__go">
              <button type="button" class="btn adv-drive" data-adv-play={c.id} hidden>Drive</button>
            </p>
            <p class="adv-note" data-adv-nogl hidden>Driving needs 3D graphics, which this browser can't draw. The map shows the course and the places on it.</p>
            <noscript><p class="adv-note">Driving needs JavaScript. The map shows the course and the places on it.</p></noscript>
            <p class="adv-keys">Arrow keys or WASD to drive. On a phone, use the pads at the bottom.</p>
            {c.id === 'wesleyan' && (
              <details class="adv-places">
                <summary>Places on the way</summary>
                <ul>
                  {landmarks.map((l) => <li><strong>{l.name}.</strong> {l.note}</li>)}
                </ul>
              </details>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="adv-back"><a href="/">Back to the island</a></p>
  </main>
  <SiteFooter />

  <div class="adv-stage" data-adv-stage hidden>
    <div class="adv-canvas" data-adv-canvas></div>
    <div class="adv-hud">
      <button type="button" class="adv-chip" data-adv-exit>Chapters</button>
      <p class="adv-chip adv-chip--clock" data-adv-race><span data-adv-lap>Lap 1/2</span> <span data-adv-time>0:00.00</span></p>
      <button type="button" class="adv-chip" data-adv-restart data-adv-race>Restart</button>
      <p class="adv-row" data-adv-race><span class="adv-next" data-adv-next></span></p>
    </div>
    <div class="adv-mini" aria-hidden="true">{first && <CampusMap live color={first.color} />}</div>
    <p class="adv-count" data-adv-count hidden aria-live="assertive"></p>
    <div class="adv-toast" data-adv-toast hidden role="status"></div>
    <div class="adv-pads" aria-hidden="true">
      <div class="adv-pads__side">
        <button type="button" tabindex="-1" class="adv-pad" data-pad="left">◀</button>
        <button type="button" tabindex="-1" class="adv-pad" data-pad="right">▶</button>
      </div>
      <div class="adv-pads__side">
        <button type="button" tabindex="-1" class="adv-pad adv-pad--brake" data-pad="brake">Brake</button>
        <button type="button" tabindex="-1" class="adv-pad adv-pad--gas" data-pad="gas">Go</button>
      </div>
    </div>
    <dialog class="adv-finish" data-adv-finish aria-labelledby="adv-finish-title">
      <h2 id="adv-finish-title">Finished!</h2>
      <div data-adv-result></div>
      <div class="adv-finish__acts">
        <button type="button" class="btn" data-adv-act="again">Race again</button>
        <button type="button" class="btn btn-ghost" data-adv-act="drive">Drive around</button>
        <button type="button" class="btn btn-ghost" data-adv-act="exit">Chapters</button>
      </div>
    </dialog>
  </div>
</Base>

<script>
  import { chapters } from '../adventure/levels';
  import type { Session } from '../adventure/play';

  const stage = document.querySelector<HTMLElement>('[data-adv-stage]')!;
  const gl = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();

  let session: Session | null = null;
  let opener: HTMLElement | null = null;

  const exit = () => {
    session?.destroy();
    session = null;
    stage.hidden = true;
    document.documentElement.classList.remove('adv-playing');
    opener?.focus();
  };

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-adv-play]')) {
    if (!gl) {
      b.closest('.adv-chapter')?.querySelector<HTMLElement>('[data-adv-nogl]')?.removeAttribute('hidden');
      continue;
    }
    b.hidden = false;
    b.addEventListener('click', async () => {
      const chapter = chapters.find((c) => c.id === b.dataset.advPlay);
      if (!chapter || session) return;
      opener = b;
      b.disabled = true;
      b.textContent = 'Loading…';
      try {
        const { play } = await import('../adventure/play');
        stage.hidden = false;
        document.documentElement.classList.add('adv-playing');
        session = play(stage, chapter, exit);
        stage.querySelector<HTMLElement>('[data-adv-exit]')?.focus({ preventScroll: true });
      } finally {
        b.disabled = false;
        b.textContent = 'Drive';
      }
    });
  }
  stage.querySelector('[data-adv-exit]')?.addEventListener('click', exit);
</script>

<style>
  .adv { padding-block: var(--space-6) var(--space-8); }
  .adv-head h1 { font-family: var(--font-display); font-size: var(--step-4); letter-spacing: -0.03em; margin: 0; }
  .adv-lede { font-size: var(--step-1); color: var(--ink-2); margin-top: var(--space-3); max-width: 36ch; }
  .adv-chapters { list-style: none; padding: 0; margin: var(--space-7) 0 0; display: grid; gap: var(--space-7); }
  .adv-chapter {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-6); align-items: center;
    background: var(--bg-raised); border-radius: var(--r-lg); padding: var(--space-5); box-shadow: var(--shadow-2);
    border-top: 6px solid var(--c);
  }
  .adv-chapter__map { border-radius: var(--r-md); overflow: hidden; background: #cfe0b5; }
  .adv-chapter__n { font-weight: 700; color: var(--c); text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--step--1); margin: 0; }
  .adv-chapter h2 { font-family: var(--font-display); font-size: var(--step-3); letter-spacing: -0.02em; margin: var(--space-1) 0 0; }
  .adv-chapter__where { color: var(--ink-3); margin-top: 0; }
  .adv-drive { background: var(--c); }
  .adv-note, .adv-keys { color: var(--ink-3); font-size: var(--step--1); }
  .adv-places summary { cursor: pointer; font-weight: 650; padding-block: var(--space-2); }
  .adv-places ul { padding-left: 1.1em; margin: var(--space-2) 0 0; display: grid; gap: var(--space-2); }
  .adv-back { margin-top: var(--space-7); }
  @media (max-width: 760px) {
    .adv-chapter { grid-template-columns: minmax(0, 1fr); padding: var(--space-4); gap: var(--space-4); }
  }

  :global(html.adv-playing), :global(html.adv-playing body) { overflow: hidden; }
  .adv-stage {
    position: fixed; inset: 0; z-index: 50; background: #bfdfe9;
    touch-action: none; overscroll-behavior: none; user-select: none; -webkit-user-select: none;
    font-family: var(--font-ui); color: var(--ink);
  }
  .adv-stage[hidden] { display: none; }
  .adv-canvas, .adv-canvas :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .adv-canvas { z-index: 0; }
  .adv-hud, .adv-mini, .adv-count, .adv-toast, .adv-pads { z-index: 1; }
  .adv-hud {
    position: absolute; top: max(12px, env(safe-area-inset-top)); left: 12px; right: 150px;
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
  }
  .adv-chip {
    margin: 0; border: 0; font: inherit; font-weight: 650; font-size: 15px; color: var(--ink);
    background: rgba(251, 246, 236, 0.92); border-radius: var(--r-pill); padding: 9px 14px; min-height: 40px;
    box-shadow: var(--shadow-1); cursor: pointer; display: inline-flex; align-items: center; gap: 10px;
  }
  .adv-chip--clock { cursor: default; font-variant-numeric: tabular-nums; }
  .adv-chip[hidden] { display: none; }
  .adv-row { flex: 0 0 100%; margin: 0; }
  .adv-row[hidden] { display: none; }
  .adv-next {
    display: inline-block;
    background: rgba(29, 26, 22, 0.72); color: var(--bg); border-radius: var(--r-pill); padding: 6px 12px; font-size: 14px; font-weight: 600;
  }
  .adv-mini {
    position: absolute; top: max(12px, env(safe-area-inset-top)); right: 12px; width: clamp(110px, 22vw, 190px);
    border-radius: var(--r-md); overflow: hidden; box-shadow: var(--shadow-2); background: #cfe0b5; pointer-events: none;
  }
  .adv-count {
    position: absolute; inset: 0; display: grid; place-items: center; margin: 0; pointer-events: none;
    font-family: var(--font-display); font-size: clamp(72px, 18vw, 160px); font-weight: 800; color: var(--bg);
    text-shadow: 0 6px 30px rgba(29, 26, 22, 0.35);
  }
  .adv-count[hidden] { display: none; }
  .adv-toast {
    position: absolute; left: 50%; transform: translateX(-50%); top: calc(max(12px, env(safe-area-inset-top)) + 100px);
    width: min(420px, calc(100% - 32px)); background: rgba(251, 246, 236, 0.95); border-radius: var(--r-md);
    padding: 12px 16px; box-shadow: var(--shadow-2); display: grid; gap: 2px; pointer-events: none;
  }
  .adv-toast[hidden] { display: none; }
  .adv-toast :global(strong) { font-family: var(--font-display); font-size: 17px; }
  .adv-toast :global(span) { color: var(--ink-2); font-size: 15px; }
  .adv-pads {
    position: absolute; left: 0; right: 0; bottom: max(14px, env(safe-area-inset-bottom));
    display: none; justify-content: space-between; padding-inline: 14px; pointer-events: none;
  }
  .adv-pads__side { display: flex; gap: 12px; pointer-events: auto; }
  .adv-pad {
    width: 76px; height: 76px; border-radius: 50%; border: 0; font: inherit; font-weight: 750; font-size: 18px;
    background: rgba(251, 246, 236, 0.82); color: var(--ink); box-shadow: var(--shadow-2); touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }
  .adv-pad--gas { background: rgba(76, 175, 106, 0.9); color: #14110d; width: 88px; height: 88px; }
  .adv-pad--brake { font-size: 14px; }
  .adv-pad:global(.is-down) { transform: scale(0.94); filter: brightness(0.92); }
  @media (pointer: coarse), (hover: none) {
    .adv-pads { display: flex; }
  }
  @media (max-width: 560px) {
    .adv-hud { right: 128px; gap: 6px; }
    .adv-mini { width: 108px; }
    .adv-chip { font-size: 14px; padding: 7px 11px; min-height: 38px; }
    .adv-toast { top: auto; bottom: calc(max(14px, env(safe-area-inset-bottom)) + 104px); }
  }
  .adv-finish {
    border: 0; border-radius: var(--r-lg); padding: var(--space-6); width: min(440px, calc(100% - 32px));
    background: var(--bg); color: var(--ink); box-shadow: var(--shadow-3); text-align: center;
  }
  .adv-finish::backdrop { background: rgba(29, 26, 22, 0.35); }
  .adv-finish h2 { font-family: var(--font-display); font-size: var(--step-2); margin: 0; }
  .adv-finish :global(.adv-finish__time) { font-family: var(--font-display); font-size: var(--step-4); font-weight: 800; margin: var(--space-2) 0; font-variant-numeric: tabular-nums; }
  .adv-finish__acts { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: var(--space-5); }
</style>

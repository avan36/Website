{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/claude", "destination": "https://claude.ambrosevannier.com/", "permanent": false },
    { "source": "/claude/board", "destination": "https://claude.ambrosevannier.com/board", "permanent": false },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/support.html", "destination": "/contact", "permanent": true },
    { "source": "/gpccode.html", "destination": "/work/privacy-research", "permanent": true },
    { "source": "/writing", "destination": "/blog", "permanent": true }
  ],
  "rewrites": [
    { "source": "/newsletter/confirm", "destination": "https://contact-form.todos-thorax09.workers.dev/newsletter/confirm" },
    { "source": "/claude/messages", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/messages" },
    { "source": "/claude/profiles", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/profiles" },
    { "source": "/claude/tasks", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/tasks" },
    { "source": "/claude/push", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/push" },
    { "source": "/claude/notes", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/notes" },
    { "source": "/claude/brief", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/brief" },
    { "source": "/claude/login", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/login" },
    { "source": "/claude/password", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/password" },
    { "source": "/claude/logout", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/logout" },
    { "source": "/claude/join", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/join" },
    { "source": "/claude/your-claude", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/your-claude" },
    { "source": "/claude/members", "destination": "https://contact-form.todos-thorax09.workers.dev/claude/members" }
  ],
  "headers": [
    { "source": "/pushkar", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/pushkar.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/media/pushkar-card.png", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "claude/elegant-hopper-vo8te3": false,
      "claude/modest-einstein-f2exnu": false
    }
  }
}
